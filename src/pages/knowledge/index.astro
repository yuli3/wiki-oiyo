---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { siteConfig } from "../../config/site.config";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const dictPosts = posts.filter((p) => p.data.track === "dictionary");
const dictCount = dictPosts.length;
const locales = siteConfig.locales;

// English concept → URL index, for linking topic-map cards to their definition.
const enConceptUrl = new Map<string, string>();
for (const p of dictPosts) {
  if ((p.data.locale ?? p.slug.split("/")[0]) !== "en") continue;
  enConceptUrl.set(p.slug.split("/").slice(1).join("/"), `/${p.slug}/`);
}
const conceptSlug = (v: string) =>
  "meaning-of-" + v.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// Read the route-ownership seed and build the human-facing topic map.
// Resolve from the build cwd (repo root) — robust across .astro bundling.
const SEED_PATH = resolve(process.cwd(), "../docs/knowledge/topics.json");
type Seed = { id: string; name?: Record<string, string>; aliases?: string[]; relatedTopicIds?: string[]; definitionOwner?: string };
let topicMap: { id: string; name: string; href: string | null; related: string[] }[] = [];
try {
  const seed = JSON.parse(readFileSync(SEED_PATH, "utf-8")) as { topics?: Seed[] };
  topicMap = (seed.topics ?? [])
    .filter((t) => t.definitionOwner === "wiki")
    .map((t) => {
      let href: string | null = null;
      for (const c of [t.id, ...(t.aliases ?? [])]) {
        const u = enConceptUrl.get(conceptSlug(c));
        if (u) { href = u; break; }
      }
      return { id: t.id, name: t.name?.en ?? t.id, href, related: t.relatedTopicIds ?? [] };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
} catch { topicMap = []; }

const resources = [
  { name: "topics.json", href: "/knowledge/topics.json", desc: `${dictCount} defined terms (schema.org DefinedTermSet) with definition, sources, locale and a stable URL.` },
  { name: "relations.json", href: "/knowledge/relations.json", desc: "Concept graph: series/topic clusters, explicit broader/narrower/related edges, and cross-locale translations." },
  { name: "index.json", href: "/knowledge/index.json", desc: "Machine-readable discovery manifest for this site and the wider knowledge network." },
];

const network = [
  { role: "Definition", name: "Oiyo Wiki", url: "https://wiki.oiyo.net" },
  { role: "Explanation", name: "Oiyo Blog", url: "https://blog.oiyo.net" },
  { role: "Execution", name: "Oiyo", url: "https://oiyo.net" },
];
---

<BaseLayout
  title="Knowledge Foundation — Citable Reference Data"
  description="A machine-citable, source-cited reference dataset for astrology, saju, tarot, personality and psychology — designed for people and AI to cite."
>
  <article class="py-24 max-w-3xl mx-auto px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-primary mb-4">Knowledge Foundation</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
      A reference dataset built to be cited
    </h1>
    <p class="text-lg text-muted-foreground leading-relaxed mb-10">
      Oiyo Wiki is the <strong>definition layer</strong> of the Oiyo knowledge network: source-cited,
      stable definitions across astrology, saju, tarot, personality and psychology — published as clean
      HTML <em>and</em> as machine-readable catalogs so that both people and AI can reference them.
    </p>

    <h2 class="text-2xl font-bold tracking-tight mb-4">Open data catalogs</h2>
    <ul class="space-y-4 mb-12">
      {resources.map((r) => (
        <li class="border border-border rounded-lg p-5">
          <a href={r.href} class="text-primary font-bold font-mono">{r.name}</a>
          <p class="text-sm text-muted-foreground mt-1">{r.desc}</p>
        </li>
      ))}
    </ul>

    {topicMap.length > 0 && (
      <>
        <h2 class="text-2xl font-bold tracking-tight mb-4">Topic map</h2>
        <p class="text-muted-foreground mb-4">Top-level concepts and how they connect. Each links to its definition.</p>
        <div class="grid sm:grid-cols-2 gap-3 mb-12">
          {topicMap.map((t) => (
            <div class="border border-border rounded-lg p-4">
              {t.href ? (
                <a href={t.href} class="font-bold hover:text-primary transition-colors">{t.name}</a>
              ) : (
                <span class="font-bold">{t.name}</span>
              )}
              {t.related.length > 0 && (
                <p class="text-xs text-muted-foreground mt-1">related: {t.related.join(", ")}</p>
              )}
            </div>
          ))}
        </div>
      </>
    )}

    <h2 class="text-2xl font-bold tracking-tight mb-4">The knowledge network</h2>
    <p class="text-muted-foreground mb-4">Three interlinked layers, each with its own <code>/knowledge/index.json</code>:</p>
    <ul class="space-y-3 mb-12">
      {network.map((n) => (
        <li class="flex items-baseline gap-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-primary w-24 shrink-0">{n.role}</span>
          <a href={n.url} class="font-medium hover:text-primary transition-colors">{n.name}</a>
          <span class="text-xs text-muted-foreground">{n.url}</span>
        </li>
      ))}
    </ul>

    <h2 class="text-2xl font-bold tracking-tight mb-4">Citation</h2>
    <p class="text-muted-foreground">
      Cite individual terms by their stable URL (see <a href="/knowledge/topics.json" class="text-primary">topics.json</a>).
      Coverage spans {locales.length} languages ({locales.join(", ")}). Attribution: <strong>Oiyo Wiki (wiki.oiyo.net)</strong>.
    </p>

    <FaqAccordion
      heading="FAQ"
      items={[
        { q: "Can I cite or reuse this data?", a: "Yes. Each term has a stable canonical URL (see <a href='/knowledge/topics.json'>topics.json</a>). Please attribute to Oiyo Wiki (wiki.oiyo.net)." },
        { q: "Is the data machine-readable?", a: "Yes — open JSON catalogs (topics.json, relations.json) plus <code>DefinedTerm</code> JSON-LD embedded in every dictionary page." },
        { q: "How current is it?", a: "Catalogs are regenerated on every build; each entry carries a published and last-reviewed date." },
      ]}
    />
  </article>
</BaseLayout>
