---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqAccordion from "../../components/shared/_oiyo-shared/FaqAccordion.astro";
import KnowledgeNetworkMap from "../../components/shared/_oiyo-shared/KnowledgeNetworkMap.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site.config";
import seedData from "../../data/knowledge-seed.json";

const posts = await getCollection("blog", ({ data }) => data.draft !== true);
const dictPosts = posts.filter((p) => p.data.track === "dictionary");
const dictCount = dictPosts.length;
const locales = siteConfig.locales;

// English concept → URL index, for linking topic-map cards to their definition.
const enConceptUrl = new Map<string, string>();
for (const p of dictPosts) {
  if ((p.data.locale ?? p.slug.split("/")[0]) !== "en") continue;
  enConceptUrl.set(p.slug.split("/").slice(1).join("/"), `/${p.slug}/`);
}
const conceptSlug = (v: string) =>
  "meaning-of-" + v.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// Build the human-facing topic map from the in-repo route-ownership seed.
type Seed = { id: string; name?: Record<string, string>; aliases?: string[]; relatedTopicIds?: string[]; definitionOwner?: string };
const topicMap = ((seedData as { topics?: Seed[] }).topics ?? [])
  .filter((t) => t.definitionOwner === "wiki")
  .map((t) => {
    let href: string | null = null;
    for (const c of [t.id, ...(t.aliases ?? [])]) {
      const u = enConceptUrl.get(conceptSlug(c));
      if (u) { href = u; break; }
    }
    return { id: t.id, name: t.name?.en ?? t.id, href, related: t.relatedTopicIds ?? [] };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const resources = [
  {
    name: "topics.json",
    href: "/knowledge/topics.json",
    // 2026-10-06 (audit S4): do not advertise definitions the wiki does not publish.
    desc: dictCount > 0
      ? `${dictCount} defined terms (schema.org DefinedTermSet) with definition, locale and a stable URL, plus the topic-ownership map.`
      : "No defined terms are published yet, so the DefinedTermSet is empty. It also carries the topic-ownership map: which Oiyo site owns each topic.",
  },
  { name: "relations.json", href: "/knowledge/relations.json", desc: "Concept graph: series/topic clusters, explicit broader/narrower/related edges, and cross-locale translations." },
  { name: "index.json", href: "/knowledge/index.json", desc: "Machine-readable discovery manifest for this site and the wider knowledge network." },
];

const network = [
  {
    role: "Reference",
    title: "Oiyo Wiki",
    href: "https://wiki.oiyo.net/knowledge/",
    summary: "Brand home, topic-ownership map and concept graph.",
    details: "Use this catalog to find which Oiyo site owns a topic. Definitions appear here only once a wiki page publishes them.",
    catalogs: [{ label: "topics.json", href: "/knowledge/topics.json" }],
    current: true,
  },
  {
    role: "Publishing",
    title: "Oiyo Blog",
    href: "https://blog.oiyo.net/knowledge/",
    summary: "Guides, lessons, comparisons, and long-form context.",
    details: "Use this catalog for guides, lessons, references, and established utilities published on the blog.",
    catalogs: [{ label: "guides.json", href: "https://blog.oiyo.net/knowledge/guides.json" }],
  },
  {
    role: "Interactive",
    title: "OIYO",
    href: "https://oiyo.net/knowledge/",
    summary: "Tests, calculators, results, and repeatable workflows.",
    details: "Use this catalog when the user wants to calculate, test, save a result, or turn knowledge into action.",
    catalogs: [{ label: "tools.json", href: "https://oiyo.net/knowledge/tools.json" }],
  },
];
---

<BaseLayout
  title="Knowledge Foundation — Oiyo Network Catalogs"
  description="Machine-readable catalogs from Oiyo Wiki: which Oiyo site owns each topic, how topics connect, and any published wiki definitions."
>
  <article class="py-24 max-w-3xl mx-auto px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-primary mb-4">Knowledge Foundation</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
      Where each topic lives in the Oiyo network
    </h1>
    <p class="text-lg text-muted-foreground leading-relaxed mb-10">
      Oiyo Wiki is the brand home of the Oiyo network. It publishes machine-readable catalogs that say
      which site owns each topic — reference articles on blog.oiyo.net, tests and tools on oiyo.net.
      {dictCount > 0
        ? ` The wiki itself currently publishes ${dictCount} definition pages.`
        : " The wiki itself does not publish definition pages at this time."}
    </p>

    <h2 class="text-2xl font-bold tracking-tight mb-4">Open data catalogs</h2>
    <ul class="space-y-4 mb-12">
      {resources.map((r) => (
        <li class="border border-border rounded-lg p-5">
          <a href={r.href} class="text-primary font-bold font-mono">{r.name}</a>
          <p class="text-sm text-muted-foreground mt-1">{r.desc}</p>
        </li>
      ))}
    </ul>

    {topicMap.length > 0 && (
      <>
        <h2 class="text-2xl font-bold tracking-tight mb-4">Topic map</h2>
        <p class="text-muted-foreground mb-4">Top-level concepts and how they connect. A concept links to its definition only when a wiki page exists.</p>
        <div class="grid sm:grid-cols-2 gap-3 mb-12">
          {topicMap.map((t) => (
            <div class="border border-border rounded-lg p-4">
              {t.href ? (
                <a href={t.href} class="font-bold hover:text-primary transition-colors">{t.name}</a>
              ) : (
                <span class="font-bold">{t.name}</span>
              )}
              {t.related.length > 0 && (
                <p class="text-xs text-muted-foreground mt-1">related: {t.related.join(", ")}</p>
              )}
            </div>
          ))}
        </div>
      </>
    )}

    <KnowledgeNetworkMap
      eyebrow="Canonical catalogs"
      heading="The knowledge network"
      intro="Start with the canonical catalog that matches the task. A content format does not force a particular domain."
      layers={network}
    />

    <h2 class="text-2xl font-bold tracking-tight mb-4">Citation</h2>
    <p class="text-muted-foreground">
      Cite the canonical page on the site that owns the topic (see <a href="/knowledge/topics.json" class="text-primary">topics.json</a> <code>topicOwnership</code>).
      Catalogs cover {locales.length} languages ({locales.join(", ")}). Attribution: <strong>Oiyo Wiki (wiki.oiyo.net)</strong>.
    </p>

    <FaqAccordion
      heading="FAQ"
      items={[
        { q: "Can I cite or reuse this data?", a: "Yes. Cite the canonical page on the owning site, and attribute catalog data to Oiyo Wiki (wiki.oiyo.net). Ownership rows in <a href='/knowledge/topics.json'>topics.json</a> are routing data, not definitions." },
        { q: "Is the data machine-readable?", a: "Yes — open JSON catalogs (topics.json, relations.json, index.json)." },
        { q: "How current is it?", a: "Catalogs are regenerated on every build." },
      ]}
    />
  </article>
</BaseLayout>
