---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "완벽주의 유형",
  "en": "Perfectionism Type",
  "ja": "完璧主義タイプ",
  "fr": "perfectionnisme",
  "es": "perfeccionismo",
  "zh": "完美主义类型",
  "cn": "完美主義類型"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/perfectionism/test" kind="test" />
