---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Strengths Discovery Test", en: "Strengths Discovery Test", ja: "Strengths Discovery Test", fr: "Strengths Discovery Test", es: "Strengths Discovery Test", zh: "Strengths Discovery Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/strengths-discovery-test/" kind="test" />
