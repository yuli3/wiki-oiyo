---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Riasec Career Test", en: "Riasec Career Test", ja: "Riasec Career Test", fr: "Riasec Career Test", es: "Riasec Career Test", zh: "Riasec Career Test", cn: "Riasec Career Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/riasec-career-test/" kind="test" />
