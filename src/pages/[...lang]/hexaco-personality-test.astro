---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Hexaco Personality Test", en: "Hexaco Personality Test", ja: "Hexaco Personality Test", fr: "Hexaco Personality Test", es: "Hexaco Personality Test", zh: "Hexaco Personality Test", cn: "Hexaco Personality Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/hexaco-personality-test/" kind="test" />
