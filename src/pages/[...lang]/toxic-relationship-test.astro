---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Toxic Relationship Test", en: "Toxic Relationship Test", ja: "Toxic Relationship Test", fr: "Toxic Relationship Test", es: "Toxic Relationship Test", zh: "Toxic Relationship Test", cn: "Toxic Relationship Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/toxic-relationship-test/" kind="test" />
