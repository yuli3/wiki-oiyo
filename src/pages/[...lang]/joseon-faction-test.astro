---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Joseon Faction Test", en: "Joseon Faction Test", ja: "Joseon Faction Test", fr: "Joseon Faction Test", es: "Joseon Faction Test", zh: "Joseon Faction Test", cn: "Joseon Faction Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/joseon-faction-test/" kind="test" />
