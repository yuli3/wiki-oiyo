---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Personal Boundaries Test", en: "Personal Boundaries Test", ja: "Personal Boundaries Test", fr: "Personal Boundaries Test", es: "Personal Boundaries Test", zh: "Personal Boundaries Test", cn: "Personal Boundaries Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/personal-boundaries-test/" kind="test" />
