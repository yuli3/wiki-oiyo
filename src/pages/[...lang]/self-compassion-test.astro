---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Self Compassion Test", en: "Self Compassion Test", ja: "Self Compassion Test", fr: "Self Compassion Test", es: "Self Compassion Test", zh: "Self Compassion Test", cn: "Self Compassion Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/self-compassion-test/" kind="test" />
