---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  ko: "출퇴근 멘탈",
  en: "Commute mental",
  ja: "通勤メンタル",
  fr: "mental du trajet",
  es: "mentalidad del trayecto",
  zh: "通勤心态",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/commute-mental/test" kind="test" />
