---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Thinking Patterns Test", en: "Thinking Patterns Test", ja: "Thinking Patterns Test", fr: "Thinking Patterns Test", es: "Thinking Patterns Test", zh: "Thinking Patterns Test", cn: "Thinking Patterns Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/thinking-patterns-test/" kind="test" />
