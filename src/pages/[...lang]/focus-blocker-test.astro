---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Focus Blocker Test", en: "Focus Blocker Test", ja: "Focus Blocker Test", fr: "Focus Blocker Test", es: "Focus Blocker Test", zh: "Focus Blocker Test", cn: "Focus Blocker Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/focus-blocker-test/" kind="test" />
