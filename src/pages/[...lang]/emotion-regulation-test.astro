---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Emotion Regulation Test", en: "Emotion Regulation Test", ja: "Emotion Regulation Test", fr: "Emotion Regulation Test", es: "Emotion Regulation Test", zh: "Emotion Regulation Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/emotion-regulation-test/" kind="test" />
