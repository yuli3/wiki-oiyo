---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Emotional Mind Test", en: "Emotional Mind Test", ja: "Emotional Mind Test", fr: "Emotional Mind Test", es: "Emotional Mind Test", zh: "Emotional Mind Test", cn: "Emotional Mind Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/emotional-mind-test/" kind="test" />
