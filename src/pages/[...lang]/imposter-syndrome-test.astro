---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Imposter Syndrome Test", en: "Imposter Syndrome Test", ja: "Imposter Syndrome Test", fr: "Imposter Syndrome Test", es: "Imposter Syndrome Test", zh: "Imposter Syndrome Test", cn: "Imposter Syndrome Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/imposter-syndrome-test/" kind="test" />
