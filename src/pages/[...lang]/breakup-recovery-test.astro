---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Breakup Recovery Test", en: "Breakup Recovery Test", ja: "Breakup Recovery Test", fr: "Breakup Recovery Test", es: "Breakup Recovery Test", zh: "Breakup Recovery Test", cn: "Breakup Recovery Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/breakup-recovery-test/" kind="test" />
