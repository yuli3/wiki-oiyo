---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Conflict Style Test", en: "Conflict Style Test", ja: "Conflict Style Test", fr: "Conflict Style Test", es: "Conflict Style Test", zh: "Conflict Style Test", cn: "Conflict Style Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/conflict-style-test/" kind="test" />
