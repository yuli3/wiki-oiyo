---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Tci Personality Test", en: "Tci Personality Test", ja: "Tci Personality Test", fr: "Tci Personality Test", es: "Tci Personality Test", zh: "Tci Personality Test", cn: "Tci Personality Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/tci-personality-test/" kind="test" />
