---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Disc Personality Test", en: "Disc Personality Test", ja: "Disc Personality Test", fr: "Disc Personality Test", es: "Disc Personality Test", zh: "Disc Personality Test", cn: "Disc Personality Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/disc-personality-test/" kind="test" />
