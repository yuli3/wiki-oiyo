---
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const targetLocale = locale === "cn" ? "zh" : locale;
const target = `https://oiyo.net/${targetLocale}/mbti/test`;
const copy: Record<Locale, { title: string; body: string; link: string }> = {
  ko: { title: "MBTI 테스트는 oiyo.net에서 진행합니다", body: "wiki.oiyo.net은 MBTI 뜻과 개념을 설명하고, 실제 테스트는 oiyo.net의 정본 페이지로 통합했습니다.", link: "MBTI 테스트로 이동" },
  en: { title: "The MBTI test now lives on oiyo.net", body: "wiki.oiyo.net defines MBTI concepts. The actual test is unified on oiyo.net.", link: "Go to the MBTI test" },
  ja: { title: "MBTIテストは oiyo.net に移動しました", body: "wiki.oiyo.net はMBTIの意味と概念を説明し、実際のテストは oiyo.net に統合しました。", link: "MBTIテストへ移動" },
  fr: { title: "Le test MBTI est sur oiyo.net", body: "wiki.oiyo.net définit les concepts MBTI. Le test lui-même est unifié sur oiyo.net.", link: "Aller au test MBTI" },
  es: { title: "El test MBTI está en oiyo.net", body: "wiki.oiyo.net define los conceptos MBTI. El test real está unificado en oiyo.net.", link: "Ir al test MBTI" },
  zh: { title: "MBTI 测试已移至 oiyo.net", body: "wiki.oiyo.net 负责 MBTI 概念定义，实际测试统一到 oiyo.net。", link: "前往 MBTI 测试" },
  cn: { title: "MBTI 測試已移至 oiyo.net", body: "wiki.oiyo.net 負責 MBTI 概念定義，實際測試統一到 oiyo.net。", link: "前往 MBTI 測試" },
};

const text = copy[locale] ?? copy.en;
---
<html lang={locale}>
  <head>
    <title>{text.title}</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <main style="font-family: system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem;">
      <h1>{text.title}</h1>
      <p>{text.body}</p>
      <p><a href={target}>{text.link}</a></p>
    </main>
  </body>
</html>
