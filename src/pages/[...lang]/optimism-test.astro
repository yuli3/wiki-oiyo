---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Optimism Test", en: "Optimism Test", ja: "Optimism Test", fr: "Optimism Test", es: "Optimism Test", zh: "Optimism Test", cn: "Optimism Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/optimism-test/" kind="test" />
