---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Risk Tolerance Test", en: "Risk Tolerance Test", ja: "Risk Tolerance Test", fr: "Risk Tolerance Test", es: "Risk Tolerance Test", zh: "Risk Tolerance Test", cn: "Risk Tolerance Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/risk-tolerance-test/" kind="test" />
