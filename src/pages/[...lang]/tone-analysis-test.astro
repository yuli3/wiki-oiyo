---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Tone Analysis Test", en: "Tone Analysis Test", ja: "Tone Analysis Test", fr: "Tone Analysis Test", es: "Tone Analysis Test", zh: "Tone Analysis Test", cn: "Tone Analysis Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/tone-analysis-test/" kind="test" />
