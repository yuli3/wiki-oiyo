---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Leadership Style Test", en: "Leadership Style Test", ja: "Leadership Style Test", fr: "Leadership Style Test", es: "Leadership Style Test", zh: "Leadership Style Test", cn: "Leadership Style Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/leadership-style-test/" kind="test" />
