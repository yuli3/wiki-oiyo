---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Dopamine Dependency Test", en: "Dopamine Dependency Test", ja: "Dopamine Dependency Test", fr: "Dopamine Dependency Test", es: "Dopamine Dependency Test", zh: "Dopamine Dependency Test", cn: "Dopamine Dependency Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/dopamine-dependency-test/" kind="test" />
