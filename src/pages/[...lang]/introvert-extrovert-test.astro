---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Introvert Extrovert Test", en: "Introvert Extrovert Test", ja: "Introvert Extrovert Test", fr: "Introvert Extrovert Test", es: "Introvert Extrovert Test", zh: "Introvert Extrovert Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/introvert-extrovert-test/" kind="test" />
