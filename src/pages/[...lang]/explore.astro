---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Item from "../../components/ui/Item.astro";
import { getTranslations, locales } from "../../lib/i18n";
import { getTrackFromData, slugifyCategory } from "../../lib/taxonomy";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

type ActiveLocale = (typeof locales)[number];

const { locale } = Astro.props as { locale: ActiveLocale };
const t = await getTranslations(locale);
const categoryNames = (t.category?.names ?? {}) as Record<string, string>;

const posts = await getCollection("blog", ({ data }) => data.draft !== true && data.locale === locale);

type ExploreCopy = {
  title: string;
  intro: string;
  home: string;
  current: string;
  dictionary: string;
  academyTitle: string;
  academyIntro: string;
};

const copyByLocale: Record<ActiveLocale, ExploreCopy> = {
  en: {
    title: "Explore the OIYO Wiki",
    intro: "Browse term definitions and public standard curricula.",
    home: "Home",
    current: "Explore",
    dictionary: "Dictionary - term definitions",
    academyTitle: "Public Knowledge Curriculum",
    academyIntro: "Core curricula covering public waste standards, atmospheric science, and education systems.",
  },
  ko: {
    title: "OIYO 위키 전체 탐색",
    intro: "용어 정의와 공공 표준 과목을 한눈에 둘러봅니다.",
    home: "홈",
    current: "전체 탐색",
    dictionary: "사전 - 용어 정의",
    academyTitle: "공공 표준 지식 과목",
    academyIntro: "자원순환·대기기상·학사일정 등 생활과 직결된 3대 공공 표준 과목입니다.",
  },
  ja: {
    title: "OIYO Wiki を探索",
    intro: "用語の定義と公共標準科目を一覧できます。",
    home: "ホーム",
    current: "探索",
    dictionary: "辞典 - 用語の定義",
    academyTitle: "公共標準知識科目",
    academyIntro: "資源循環・気象・学事日程など生活に直結する3つの公共標準科目です。",
  },
  zh: {
    title: "浏览 OIYO Wiki",
    intro: "浏览术语定义与公共标准课程。",
    home: "首页",
    current: "浏览",
    dictionary: "词典 - 术语定义",
    academyTitle: "公共标准知识课程",
    academyIntro: "涵盖垃圾分类、气象气候、教育学制等生活标准的三大核心科目。",
  },
  fr: {
    title: "Explorer le Wiki OIYO",
    intro: "Parcourez les définitions et les programmes de connaissances publiques.",
    home: "Accueil",
    current: "Explorer",
    dictionary: "Dictionnaire - definitions",
    academyTitle: "Programmes de connaissances publiques",
    academyIntro: "Trois programmes couvrant le tri des déchets, la météorologie et le système éducatif.",
  },
  es: {
    title: "Explorar OIYO Wiki",
    intro: "Explora definiciones y programas de conocimiento público.",
    home: "Inicio",
    current: "Explorar",
    dictionary: "Diccionario - definiciones",
    academyTitle: "Programas de conocimiento público",
    academyIntro: "Tres materias clave que cubren normas de reciclaje, meteorología y calendarios académicos.",
  },
};
const copy = copyByLocale[locale] ?? copyByLocale.en;

// dictionary: track → category → count (link to category page)
const dict = posts.filter((p) => getTrackFromData(p.data) === "dictionary");
const dictByCat = new Map<string, number>();
for (const p of dict) {
  const c = p.data.category ?? "Etc";
  dictByCat.set(c, (dictByCat.get(c) ?? 0) + 1);
}
const dictCats = [...dictByCat.entries()].sort((a, b) => b[1] - a[1]);
const catLabel = (c: string) => categoryNames[c] ?? c;
const title = copy.title;
const intro = copy.intro;

const slugOf = (slug: string) => slug.split("/").slice(1).join("/");

// academy: public standard curriculum (grouped by series)
const academyPosts = posts.filter((p) => p.data.track === "academy" && !!p.data.series);
const seriesMap = new Map<string, { series: string; title: string; category: string; posts: typeof academyPosts }>();
for (const p of academyPosts) {
  const s = p.data.series as string;
  const existing = seriesMap.get(s);
  if (existing) {
    existing.posts.push(p);
  } else {
    const courseTitle = p.data.title.split(/\s+[—:-]\s+|:\s*/)[0] || s;
    seriesMap.set(s, {
      series: s,
      title: courseTitle,
      category: p.data.category ?? "general",
      posts: [p],
    });
  }
}
for (const entry of seriesMap.values()) {
  entry.posts.sort((a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0));
}
const courses = [...seriesMap.values()];
---

<BaseLayout title={title} description={intro}>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav class="mb-4 text-xs text-green-700/70" aria-label="Breadcrumb">
      <a class="hover:underline" href={`/${locale}`}>{copy.home}</a> <span class="mx-1">›</span>
      <span class="font-semibold">{copy.current}</span>
    </nav>
    <h1 class="text-3xl font-black text-green-950">{title}</h1>
    <p class="mt-2 text-sm text-green-700">{intro}</p>

    {courses.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 flex items-baseline gap-2 text-xl font-black text-green-900">
          {copy.academyTitle} <span class="text-sm font-medium text-green-600">{academyPosts.length}</span>
        </h2>
        <p class="mb-4 text-xs text-green-700">{copy.academyIntro}</p>
        <div class="grid gap-4 sm:grid-cols-3">
          {courses.map((course) => (
            <div class="rounded-xl border border-green-200 bg-card p-4 shadow-none">
              <span class="text-[11px] font-bold uppercase tracking-wider text-green-800 bg-green-100/70 px-2 py-0.5 rounded border border-green-200">
                {catLabel(course.category)}
              </span>
              <h3 class="mt-2 text-base font-black text-green-950">{course.title}</h3>
              <ul class="mt-3 divide-y divide-green-100 text-xs">
                {course.posts.map((cp) => (
                  <li class="py-1.5">
                    <a href={`/${locale}/${slugOf(cp.slug)}/`} class="group flex items-start gap-1.5 text-foreground hover:text-green-800">
                      <span class="font-bold text-green-700 shrink-0">{cp.data.chapter ? `${cp.data.chapter}장.` : "•"}</span>
                      <span class="line-clamp-1 group-hover:underline">{cp.data.chapterTitleShort ?? cp.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="mb-3 flex items-baseline gap-2 text-xl font-black text-green-900">
        {copy.dictionary} <span class="text-sm font-medium text-green-600">{dict.length}</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {dictCats.map(([cat, n]) => (
          <Item
            href={`/${locale}/category/${slugifyCategory(cat)}`}
            title={catLabel(cat)}
            meta={n}
          />
        ))}
      </div>
    </section>

    {/* OIYO 지식 네트워크 — 정의(wiki)→설명(blog)→실행(oiyo) 크로스도메인 */}
    <section class="mt-12 rounded-2xl border border-green-100 bg-green-50/40 p-5">
      <h2 class="mb-1 text-lg font-black text-green-950">{locale === "ko" ? "OIYO 지식 네트워크" : "OIYO Knowledge Network"}</h2>
      <p class="mb-3 text-sm text-green-700">{locale === "ko" ? "한 주제를 정의 → 설명 → 실행으로 잇습니다." : "Each topic connects: definition → explanation → tool."}</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-green-200 bg-card p-4">
          <div class="text-xs font-bold uppercase tracking-widest text-green-600">{locale === "ko" ? "정의" : "Definition"}</div>
          <div class="mt-1 font-bold text-green-950">wiki.oiyo.net</div>
          <div class="mt-1 text-xs text-green-700">{locale === "ko" ? "지금 보고 있는 사전" : "the dictionary you're in"}</div>
        </div>
        <a href={`https://blog.oiyo.net/${locale}/`} class="rounded-xl border border-green-200 bg-card p-4 transition-colors hover:border-green-400 hover:bg-green-50">
          <div class="text-xs font-bold uppercase tracking-widest text-green-600">{locale === "ko" ? "설명" : "Explanation"}</div>
          <div class="mt-1 font-bold text-green-950">blog.oiyo.net →</div>
          <div class="mt-1 text-xs text-green-700">{locale === "ko" ? "글로 더 읽기" : "more reading"}</div>
        </a>
        <a href={`https://oiyo.net/${locale}/`} class="rounded-xl border border-green-200 bg-card p-4 transition-colors hover:border-green-400 hover:bg-green-50">
          <div class="text-xs font-bold uppercase tracking-widest text-green-600">{locale === "ko" ? "실행" : "Tools"}</div>
          <div class="mt-1 font-bold text-green-950">oiyo.net →</div>
          <div class="mt-1 text-xs text-green-700">{locale === "ko" ? "테스트·계산기로 직접" : "tests & calculators"}</div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
