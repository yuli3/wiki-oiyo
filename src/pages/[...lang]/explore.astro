---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Item from "../../components/ui/Item.astro";
import { getTranslations, locales } from "../../lib/i18n";
import { getTrackFromData, slugifyCategory } from "../../lib/taxonomy";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

type ActiveLocale = (typeof locales)[number];

const { locale } = Astro.props as { locale: ActiveLocale };
const t = await getTranslations(locale);
const categoryNames = (t.category?.names ?? {}) as Record<string, string>;

const posts = await getCollection("blog", ({ data }) => data.draft !== true && data.locale === locale);

type ExploreCopy = {
  title: string;
  intro: string;
  home: string;
  current: string;
  dictionary: string;
  academyTitle: string;
  academyIntro: string;
  chapter: (n: number) => string;
  supportGuide: string;
  supportGuideMeta: string;
};

const copyByLocale: Record<ActiveLocale, ExploreCopy> = {
  en: {
    title: "Explore the OIYO Wiki",
    intro: "Browse term definitions and public standard curricula.",
    home: "Home",
    current: "Explore",
    dictionary: "Dictionary - term definitions",
    academyTitle: "Public Knowledge Curriculum",
    academyIntro: "Chapter-by-chapter courses on public standards and everyday systems.",
    chapter: (n) => `Ch. ${n}`,
    supportGuide: "Government support guide",
    supportGuideMeta: "Welfare, health, housing and jobs — official links",
  },
  ko: {
    title: "OIYO 위키 전체 탐색",
    intro: "용어 정의와 공공 표준 과목을 한눈에 둘러봅니다.",
    home: "홈",
    current: "전체 탐색",
    dictionary: "사전 - 용어 정의",
    academyTitle: "공공 표준 지식 과목",
    academyIntro: "생활과 직결된 공공 표준·제도를 장별로 정리한 과목입니다.",
    chapter: (n) => `${n}장.`,
    supportGuide: "정부 지원 가이드",
    supportGuideMeta: "복지·의료·주거·취업 공식 안내",
  },
  ja: {
    title: "OIYO Wiki を探索",
    intro: "用語の定義と公共標準科目を一覧できます。",
    home: "ホーム",
    current: "探索",
    dictionary: "辞典 - 用語の定義",
    academyTitle: "公共標準知識科目",
    academyIntro: "暮らしに直結する公共の基準・制度を章ごとにまとめた科目です。",
    chapter: (n) => `第${n}章`,
    supportGuide: "政府支援ガイド",
    supportGuideMeta: "福祉・医療・住居・就労の公式案内",
  },
  zh: {
    title: "浏览 OIYO Wiki",
    intro: "浏览术语定义与公共标准课程。",
    home: "首页",
    current: "浏览",
    dictionary: "词典 - 术语定义",
    academyTitle: "公共标准知识课程",
    academyIntro: "按章节整理与日常生活相关的公共标准与制度课程。",
    chapter: (n) => `第${n}章`,
    supportGuide: "政府补助指南",
    supportGuideMeta: "福利、医疗、住房与就业官方信息",
  },
  fr: {
    title: "Explorer le Wiki OIYO",
    intro: "Parcourez les définitions et les programmes de connaissances publiques.",
    home: "Accueil",
    current: "Explorer",
    dictionary: "Dictionnaire - definitions",
    academyTitle: "Programmes de connaissances publiques",
    academyIntro: "Des cours chapitre par chapitre sur les normes publiques et les systèmes du quotidien.",
    chapter: (n) => `Ch. ${n}`,
    supportGuide: "Guide des aides publiques",
    supportGuideMeta: "Aide sociale, santé, logement, emploi — liens officiels",
  },
  es: {
    title: "Explorar OIYO Wiki",
    intro: "Explora definiciones y programas de conocimiento público.",
    home: "Inicio",
    current: "Explorar",
    dictionary: "Diccionario - definiciones",
    academyTitle: "Programas de conocimiento público",
    academyIntro: "Cursos por capítulos sobre normas públicas y sistemas de la vida diaria.",
    chapter: (n) => `Cap. ${n}`,
    supportGuide: "Guía de ayudas públicas",
    supportGuideMeta: "Bienestar, salud, vivienda y empleo — enlaces oficiales",
  },
};
const copy = copyByLocale[locale] ?? copyByLocale.en;

// dictionary: track → category → count (link to category page)
const dict = posts.filter((p) => getTrackFromData(p.data) === "dictionary");
const dictByCat = new Map<string, number>();
for (const p of dict) {
  const c = p.data.category ?? "Etc";
  dictByCat.set(c, (dictByCat.get(c) ?? 0) + 1);
}
const dictCats = [...dictByCat.entries()].sort((a, b) => b[1] - a[1]);
const catLabel = (c: string) => categoryNames[c] ?? c;
const title = copy.title;
const intro = copy.intro;

const slugOf = (slug: string) => slug.split("/").slice(1).join("/");

// academy: public standard curriculum (grouped by series)
const academyPosts = posts.filter((p) => p.data.track === "academy" && !!p.data.series);
const seriesMap = new Map<string, { series: string; title: string; category: string; posts: typeof academyPosts }>();
for (const p of academyPosts) {
  const s = p.data.series as string;
  const existing = seriesMap.get(s);
  if (existing) {
    existing.posts.push(p);
  } else {
    const courseTitle = p.data.title.split(/\s+[—:-]\s+|:\s*/)[0] || s;
    seriesMap.set(s, {
      series: s,
      title: courseTitle,
      category: p.data.category ?? "general",
      posts: [p],
    });
  }
}
for (const entry of seriesMap.values()) {
  entry.posts.sort((a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0));
}
const courses = [...seriesMap.values()];
---

<BaseLayout title={title} description={intro}>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav class="mb-4 text-xs text-muted-foreground" aria-label="Breadcrumb">
      <a class="hover:underline" href={`/${locale}`}>{copy.home}</a> <span class="mx-1">›</span>
      <span class="font-semibold">{copy.current}</span>
    </nav>
    <h1 class="text-3xl font-black text-foreground">{title}</h1>
    <p class="mt-2 text-sm text-muted-foreground">{intro}</p>

    {courses.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 flex items-baseline gap-2 text-xl font-black text-foreground">
          {copy.academyTitle} <span class="text-sm font-medium text-primary">{academyPosts.length}</span>
        </h2>
        <p class="mb-4 text-xs text-muted-foreground">{copy.academyIntro}</p>
        <div class="grid gap-4 sm:grid-cols-3">
          {courses.map((course) => (
            <div class="rounded-xl border border-border bg-card p-4 shadow-none">
              <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-2 py-0.5 rounded border border-primary/20">
                {catLabel(course.category)}
              </span>
              <h3 class="mt-2 text-base font-black text-foreground">{course.title}</h3>
              <ul class="mt-3 divide-y divide-border text-xs">
                {course.posts.map((cp) => (
                  <li class="py-1.5">
                    <a href={`/${locale}/${slugOf(cp.slug)}/`} class="group flex items-start gap-1.5 text-foreground hover:text-primary">
                      <span class="font-bold text-primary shrink-0">{cp.data.chapter ? copy.chapter(cp.data.chapter) : "•"}</span>
                      <span class="line-clamp-1 group-hover:underline">{cp.data.chapterTitleShort ?? cp.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-10">
      <h2 class="mb-3 flex items-baseline gap-2 text-xl font-black text-foreground">
        {copy.dictionary} <span class="text-sm font-medium text-primary">{dict.length}</span>
      </h2>
      <div class="grid gap-2 sm:grid-cols-2">
        {dictCats.map(([cat, n]) => (
          <Item
            href={`/${locale}/category/${slugifyCategory(cat)}`}
            title={catLabel(cat)}
            meta={n}
          />
        ))}
      </div>
    </section>

    <section class="mt-10">
      <div class="grid gap-2 sm:grid-cols-2">
        <Item
          href={`/${locale}/government-support-guide/`}
          title={copy.supportGuide}
          meta={copy.supportGuideMeta}
        />
      </div>
    </section>

    {/* OIYO 지식 네트워크 — 정의(wiki)→설명(blog)→실행(oiyo)→실무(tools) 크로스도메인 */}
    <section class="mt-12 rounded-2xl border border-border bg-muted/40 p-5">
      <h2 class="mb-1 text-lg font-black text-foreground">{locale === "ko" ? "OIYO 지식 네트워크" : "OIYO Knowledge Network"}</h2>
      <p class="mb-3 text-sm text-muted-foreground">{locale === "ko" ? "한 주제를 정의 → 설명 → 테스트 → 실무 도구로 잇습니다." : "Each topic connects: definition → explanation → interactive test → practical tools."}</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border bg-card p-4">
          <div class="text-xs font-bold uppercase tracking-widest text-primary">{locale === "ko" ? "정의" : "Definition"}</div>
          <div class="mt-1 font-bold text-foreground">wiki.oiyo.net</div>
          <div class="mt-1 text-xs text-muted-foreground">{locale === "ko" ? "지금 보고 있는 사전" : "the dictionary you're in"}</div>
        </div>
        <a href={`https://blog.oiyo.net/${locale}/`} class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-muted/50">
          <div class="text-xs font-bold uppercase tracking-widest text-primary">{locale === "ko" ? "설명" : "Explanation"}</div>
          <div class="mt-1 font-bold text-foreground">blog.oiyo.net →</div>
          <div class="mt-1 text-xs text-muted-foreground">{locale === "ko" ? "글로 더 읽기" : "more reading"}</div>
        </a>
        <a href={`https://oiyo.net/${locale}/`} class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-muted/50">
          <div class="text-xs font-bold uppercase tracking-widest text-primary">{locale === "ko" ? "테스트" : "Tests"}</div>
          <div class="mt-1 font-bold text-foreground">oiyo.net →</div>
          <div class="mt-1 text-xs text-muted-foreground">{locale === "ko" ? "심리·운세·사주" : "tests & interactive"}</div>
        </a>
        <a href="https://tools.oiyo.net/" class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-primary hover:bg-muted/50">
          <div class="text-xs font-bold uppercase tracking-widest text-primary">{locale === "ko" ? "실무" : "Utilities"}</div>
          <div class="mt-1 font-bold text-foreground">tools.oiyo.net →</div>
          <div class="mt-1 text-xs text-muted-foreground">{locale === "ko" ? "급여·퇴직금·연차·공과금" : "payroll & public calculators"}</div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
