---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Procrastination Type Test", en: "Procrastination Type Test", ja: "Procrastination Type Test", fr: "Procrastination Type Test", es: "Procrastination Type Test", zh: "Procrastination Type Test", cn: "Procrastination Type Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/procrastination-type-test/" kind="test" />
