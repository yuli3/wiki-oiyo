---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { locale: lang },
  }));
}

const { locale } = Astro.props as { locale: Locale };

const names: Record<Locale, string> = {
  ko: "불안감 자가 점검",
  en: "Anxiety screening",
  ja: "不安スクリーニング",
  fr: "dépistage de l'anxiété",
  es: "cribado de ansiedad",
  zh: "焦慮篩查",
  cn: "焦虑筛查",
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/anxiety/test/" kind="test" />
