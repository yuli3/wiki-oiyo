---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = {
  "ko": "사회불안",
  "en": "Social anxiety",
  "ja": "社交不安",
  "fr": "anxiété sociale",
  "es": "ansiedad social",
  "zh": "社交焦虑",
  "cn": "社交焦慮"
};
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/social-anxiety/test" kind="test" />
