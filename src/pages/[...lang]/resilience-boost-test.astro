---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Resilience Boost Test", en: "Resilience Boost Test", ja: "Resilience Boost Test", fr: "Resilience Boost Test", es: "Resilience Boost Test", zh: "Resilience Boost Test", cn: "Resilience Boost Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/resilience-boost-test/" kind="test" />
