---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config/site.config";
import { getTranslations } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return siteConfig.locales.map((lang) => ({ params: { lang } }));
}

const { lang: locale } = Astro.params;
const translations = await getTranslations(locale as Locale);

// Build a serializable search index at build time
const allPosts = await getCollection("blog", (post) => {
  const postLocale = post.slug.split("/")[0];
  return !post.data.draft && postLocale === locale;
});

const searchIndex = allPosts.map((post) => {
  const parts = post.slug.split("/");
  const slug = parts.slice(1).join("/");
  return {
    slug: `/${locale}/${slug}/`,
    title: post.data.title,
    description: post.data.description,
    category: post.data.category ?? "",
    tags: post.data.tags ?? [],
    pubDate: post.data.pubDate.toISOString().split("T")[0],
  };
});


// #17 cross-site search labels
const crossLabels = ({
  ko: { heading: "다른 사이트에서 더 찾기", target: "OIYO 블로그에서 검색", oiyo: "OIYO 테스트 둘러보기" },
  en: { heading: "Search more on our other sites", target: "Search OIYO Blog", oiyo: "Browse OIYO tests" },
  ja: { heading: "他のサイトでさらに探す", target: "OIYOブログで検索", oiyo: "OIYOテストを見る" },
  zh: { heading: "在其他站点继续查找", target: "在OIYO博客搜索", oiyo: "浏览OIYO测试" },
  fr: { heading: "Chercher sur nos autres sites", target: "Chercher sur le blog OIYO", oiyo: "Voir les tests OIYO" },
  es: { heading: "Buscar en nuestros otros sitios", target: "Buscar en el blog OIYO", oiyo: "Ver los tests de OIYO" },
} as Record<string, { heading: string; target: string; oiyo: string }>)[locale] ?? {
  heading: "Search more on our other sites", target: "Search OIYO Blog", oiyo: "Browse OIYO tests" };
const crossSearchBase = `https://blog.oiyo.net/${locale}/search/`;

const popularMap: Record<string, { label: string; keywords: string[] }> = {
  ko: {
    label: "추천 검색어",
    keywords: ["근로계약서", "주휴수당", "퇴직금", "학년도", "미세먼지", "쓰레기배출"],
  },
  en: {
    label: "Popular topics",
    keywords: ["Labor Law", "Academic Calendar", "Weather", "Waste Management"],
  },
  ja: {
    label: "人気の検索ワード",
    keywords: ["労働法", "学年度", "気象", "ゴミ排出"],
  },
  zh: {
    label: "热门搜索",
    keywords: ["劳动法", "学年度", "气象", "垃圾分类"],
  },
  fr: {
    label: "Sujets populaires",
    keywords: ["Droit du travail", "Calendrier scolaire", "Météo"],
  },
  es: {
    label: "Temas populares",
    keywords: ["Derecho laboral", "Calendario escolar", "Clima"],
  },
};
const popular = popularMap[locale as string] ?? popularMap.en;

const searchLabels = {
  title: translations.search.title,
  placeholder: translations.search.placeholder,
  results: translations.search.results,
  no_results: translations.search.noResults,
};
---

<BaseLayout title={searchLabels.title} noindex>
  <div class="container mx-auto px-4 py-24 max-w-2xl">
    <h1 class="text-4xl font-extrabold tracking-tight mb-10">{searchLabels.title}</h1>

    <div id="search-root" data-index={JSON.stringify(searchIndex)} data-labels={JSON.stringify(searchLabels)}>
      <div class="relative w-full mb-3">
        <input
          id="search-input"
          type="search"
          placeholder={searchLabels.placeholder}
          class="w-full rounded-xl border border-border bg-card pl-4 pr-10 py-3 text-base shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/50"
          autofocus
          aria-label={searchLabels.placeholder}
        />
        <button
          id="search-clear"
          type="button"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground text-sm font-bold w-6 h-6 flex items-center justify-center rounded-full hover:bg-muted"
          aria-label="Clear search"
        >
          ✕
        </button>
      </div>

      <div id="popular-chips" class="flex flex-wrap items-center gap-1.5 mb-6">
        <span class="text-xs text-muted-foreground mr-1 font-medium">{popular.label}:</span>
        {popular.keywords.map((kw) => (
          <button
            type="button"
            data-chip="true"
            data-query={kw}
            class="rounded-lg border border-border bg-card px-2.5 py-1 text-xs text-foreground hover:border-primary/50 hover:text-primary transition-colors cursor-pointer"
          >
            {kw}
          </button>
        ))}
      </div>

      <div id="search-meta" class="text-sm text-muted-foreground mb-4 min-h-[1.25rem]"></div>
      <ul id="search-results" class="space-y-4" role="list" aria-live="polite" aria-atomic="true"></ul>

      <!-- #17 cross-site search -->
      <div id="cross-search" class="hidden mt-10 rounded-xl border border-border/60 bg-card p-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground mb-3">{crossLabels.heading}</p>
        <div class="flex flex-wrap gap-2">
          <a id="cross-search-link" href={crossSearchBase} rel="noopener"
             class="rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors">
            {crossLabels.target} →
          </a>
          <a href={`https://oiyo.net/${locale}/tests/`} rel="noopener"
             class="rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors">
            {crossLabels.oiyo} →
          </a>
        </div>
      </div>
    </div>

    <script>
      import Fuse, { type FuseResult } from "fuse.js";

      interface SearchItem {
        slug: string;
        title: string;
        description: string;
        category: string;
        tags: string[];
        pubDate: string;
      }

      interface SearchLabels {
        results: string;
        no_results: string;
      }

      const root = document.getElementById("search-root");
      if (root) {
        const index: SearchItem[] = JSON.parse(root.dataset.index || "[]");
        const labels: SearchLabels = JSON.parse(root.dataset.labels || "{}");
        const input = document.getElementById("search-input") as HTMLInputElement | null;
        const clearBtn = document.getElementById("search-clear") as HTMLButtonElement | null;
        const resultsList = document.getElementById("search-results") as HTMLUListElement | null;
        const metaEl = document.getElementById("search-meta") as HTMLDivElement | null;

        let fuse: Fuse<SearchItem> | null = null;

        function initFuse(): void {
          if (fuse) return;
          fuse = new Fuse(index, {
            keys: [
              { name: "title", weight: 3 },
              { name: "description", weight: 2 },
              { name: "tags", weight: 1.5 },
              { name: "category", weight: 1 },
            ],
            threshold: 0.35,
            includeScore: true,
            minMatchCharLength: 2,
          });
          const q = new URLSearchParams(window.location.search).get("q");
          if (q && input) {
            input.value = q;
            runSearch(q);
          }
        }

        function renderResults(results: FuseResult<SearchItem>[], query: string): void {
          if (!resultsList || !metaEl) return;
          resultsList.innerHTML = "";
          if (results.length === 0) {
            metaEl.textContent = `${labels.no_results} "${query}"`;
            return;
          }
          metaEl.textContent = `${results.length} ${labels.results} "${query}"`;
          for (const { item } of results) {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = item.slug;
            a.className = "group block rounded-xl border border-border/60 bg-card p-4 hover:border-primary/50 hover:bg-primary/5 transition-colors";

            if (item.category) {
              const cat = document.createElement("span");
              cat.className = "text-[10px] font-bold uppercase tracking-wider text-primary/70 mb-1 block";
              cat.textContent = item.category;
              a.appendChild(cat);
            }

            const title = document.createElement("p");
            title.className = "font-semibold text-sm leading-snug group-hover:text-primary transition-colors mb-1";
            title.textContent = item.title;
            a.appendChild(title);

            const desc = document.createElement("p");
            desc.className = "text-xs text-muted-foreground line-clamp-2";
            desc.textContent = item.description;
            a.appendChild(desc);

            if (item.tags && item.tags.length > 0) {
              const tagsWrapper = document.createElement("div");
              tagsWrapper.className = "flex flex-wrap gap-1 mt-2";
              for (const tag of item.tags.slice(0, 4)) {
                const tagSpan = document.createElement("span");
                tagSpan.className = "text-[10px] px-1.5 py-0.5 rounded bg-muted text-muted-foreground";
                tagSpan.textContent = `#${tag}`;
                tagsWrapper.appendChild(tagSpan);
              }
              a.appendChild(tagsWrapper);
            }

            const time = document.createElement("time");
            time.className = "text-[11px] text-muted-foreground/60 mt-2 block";
            time.textContent = item.pubDate;
            a.appendChild(time);

            li.appendChild(a);
            resultsList.appendChild(li);
          }
        }

        function runSearch(query: string): void {
          if (!fuse || !resultsList || !metaEl) return;
          const trimmed = query.trim();

          if (clearBtn) {
            clearBtn.classList.toggle("hidden", !trimmed);
          }

          document.querySelectorAll("[data-chip]").forEach((btn) => {
            const chipQ = (btn as HTMLElement).dataset.query;
            const isMatch = chipQ && trimmed && (chipQ === trimmed || trimmed.includes(chipQ));
            btn.classList.toggle("border-primary", Boolean(isMatch));
            btn.classList.toggle("text-primary", Boolean(isMatch));
          });

          if (!trimmed) {
            resultsList.innerHTML = "";
            metaEl.textContent = "";
            const cross = document.getElementById("cross-search");
            if (cross) cross.classList.add("hidden");
            const url = new URL(window.location.href);
            url.searchParams.delete("q");
            history.replaceState(null, "", url.pathname);
            return;
          }

          const results = fuse.search(trimmed);
          renderResults(results, trimmed);

          const cross = document.getElementById("cross-search");
          const crossLink = document.getElementById("cross-search-link") as HTMLAnchorElement | null;
          if (cross && crossLink) {
            cross.classList.remove("hidden");
            const base = crossLink.href.split("?")[0];
            crossLink.href = `${base}?q=${encodeURIComponent(trimmed)}`;
          }

          const url = new URL(window.location.href);
          url.searchParams.set("q", trimmed);
          history.replaceState(null, "", url.toString());
        }

        let debounceTimer: ReturnType<typeof setTimeout>;
        if (input) {
          input.addEventListener("input", (e) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => runSearch((e.target as HTMLInputElement).value), 150);
          });
          input.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
              input.value = "";
              runSearch("");
            }
          });
        }

        if (clearBtn) {
          clearBtn.addEventListener("click", () => {
            if (input) {
              input.value = "";
              input.focus();
              runSearch("");
            }
          });
        }

        document.querySelectorAll("[data-chip]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const q = (btn as HTMLElement).dataset.query || "";
            if (input) {
              input.value = q;
              input.focus();
              runSearch(q);
            }
          });
        });

        initFuse();
      }
    </script>
  </div>
</BaseLayout>
