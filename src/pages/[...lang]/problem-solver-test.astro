---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Problem Solver Test", en: "Problem Solver Test", ja: "Problem Solver Test", fr: "Problem Solver Test", es: "Problem Solver Test", zh: "Problem Solver Test", cn: "Problem Solver Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/problem-solver-test/" kind="test" />
