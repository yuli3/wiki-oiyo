---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Cognitive Bias Test", en: "Cognitive Bias Test", ja: "Cognitive Bias Test", fr: "Cognitive Bias Test", es: "Cognitive Bias Test", zh: "Cognitive Bias Test", cn: "Cognitive Bias Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/cognitive-bias-test/" kind="test" />
