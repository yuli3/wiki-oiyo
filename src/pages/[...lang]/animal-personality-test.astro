---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Animal Personality Test", en: "Animal Personality Test", ja: "Animal Personality Test", fr: "Animal Personality Test", es: "Animal Personality Test", zh: "Animal Personality Test", cn: "Animal Personality Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/animal-personality-test/" kind="test" />
