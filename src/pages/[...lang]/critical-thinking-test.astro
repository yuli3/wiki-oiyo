---
import OiyoCanonicalRedirect from "../../components/OiyoCanonicalRedirect.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const names: Record<Locale, string> = { ko: "Critical Thinking Test", en: "Critical Thinking Test", ja: "Critical Thinking Test", fr: "Critical Thinking Test", es: "Critical Thinking Test", zh: "Critical Thinking Test", cn: "Critical Thinking Test" };
---
<OiyoCanonicalRedirect locale={locale} itemName={names[locale] ?? names.en} targetPath="/critical-thinking-test/" kind="test" />
