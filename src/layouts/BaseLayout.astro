---
import SEO from "../components/SEO.astro";
import { getLocaleFromPath, getTranslations } from "../lib/i18n";
import { siteConfig } from "../config/site.config";
import "../styles/global.css";
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter";
import AhoxyWelcome from '../components/AhoxyWelcome.astro';

// BCP-47 mapping: Astro locale → HTML lang attribute standard value
const BCP47: Record<string, string> = {
  en: "en", ko: "ko", ja: "ja", fr: "fr", es: "es",
  zh: "zh-CN", // zh folder = Simplified Chinese
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  availableLocales?: string[];
  track?: string;
  series?: string;
  definition?: string;
  // Search-result pages must stay out of the index (Google quality guidelines).
  noindex?: boolean;
}

const { title, description, image, type, pubDate, updatedDate, tags, category, author, availableLocales, track, series, definition, noindex } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = await getTranslations(locale);
const nav = t.nav as Record<string, string>;

const scrollSnapEnabled = siteConfig.features.scrollSnap;

// Helper to generate localized path preserving current slug
const locales = siteConfig.locales;
const currentPathname = Astro.url.pathname;

const getLocalizedPath = (targetLocale: string) => {
  const firstSegment = currentPathname.split("/")[1];
  // Locale-less pages (e.g. /knowledge) have no per-locale variants; keep them
  // self-referential so the switcher never points to a non-existent /xx/ copy.
  if (!locales.includes(firstSegment)) {
    return currentPathname;
  }
  const restOfPath = currentPathname.replace(`/${firstSegment}`, "") || "/";

  const localizedPath = restOfPath === "/"
    ? `/${targetLocale}/`
    : `/${targetLocale}${restOfPath}`;

  return localizedPath.startsWith("/") ? localizedPath : `/${localizedPath}`;
};

const navItems = [
  { href: `/${locale}/`, label: nav.home ?? "Home" },
  { href: `/${locale}/explore`, label: nav.explore ?? "Explore" },
  { href: `/${locale}/explore`, label: nav.explore ?? "Explore" },
  // IA consolidation: wiki has no tools of its own (tools live in the family's
  // unified catalog). "Tools/도구들" points at the canonical blog.oiyo.net hub.
  { href: `https://blog.oiyo.net/${locale}/tools/`, label: nav.tools ?? "Tools" },
];

// Sister sites for family nav (footer + hamburger drawer).
// news is a single-locale (ko) site — it has no /{locale}/ routes, so
// appending the locale path would land on their 404 page.
const FAMILY = [
  { host: "oiyo.net", name: "OIYO tests", localePath: true, tag: { ko: "심리테스트", en: "Psychology tests", ja: "心理テスト", zh: "心理测试", fr: "Tests psychologiques", es: "Tests psicológicos" } },
  { host: "blog.oiyo.net", name: "OIYO blog", localePath: true, tag: { ko: "콘텐츠", en: "Articles", ja: "記事", zh: "文章", fr: "Articles", es: "Artículos" } },
  { host: "wiki.oiyo.net", name: "OIYO wiki", localePath: true, tag: { ko: "지식창고", en: "Knowledge repository", ja: "知識倉庫", zh: "知识库", fr: "Réserve de connaissances", es: "Archivo de conocimiento" } },
  { host: "game.oiyo.net", name: "OIYO game", localePath: true, tag: { ko: "게임", en: "Games", ja: "ゲーム", zh: "游戏", fr: "Jeux", es: "Juegos" } },
  { host: "news.oiyo.net", name: "OIYO news", localePath: false, tag: { ko: "뉴스·AI", en: "News & AI", ja: "ニュース・AI", zh: "新闻·AI", fr: "Actualités et IA", es: "Noticias e IA" } },
];
const familyHref = (f: (typeof FAMILY)[number], medium: string) =>
  `https://${f.host}/${f.localePath ? `${locale}/` : ""}?utm_source=wiki&utm_medium=${medium}&utm_campaign=family_nav`;

// Flags + native names for the language switcher (family-wide convention:
// flag emoji plus a visible text label so it is never icon-only).
const allLangItems = [
  { code: "en", label: "EN", flag: "\u{1F1FA}\u{1F1F8}", name: "English" },
  { code: "ko", label: "KO", flag: "\u{1F1F0}\u{1F1F7}", name: "한국어" },
  { code: "ja", label: "JA", flag: "\u{1F1EF}\u{1F1F5}", name: "日本語" },
  { code: "fr", label: "FR", flag: "\u{1F1EB}\u{1F1F7}", name: "Français" },
  { code: "es", label: "ES", flag: "\u{1F1EA}\u{1F1F8}", name: "Español" },
  { code: "zh", label: "ZH", flag: "\u{1F1E8}\u{1F1F3}", name: "中文" },
];
// Only offer locales the current page actually exists in (article pages pass
// availableLocales); fall back to all. cn is removed from routing entirely.
const langItems = availableLocales && availableLocales.length
  ? allLangItems.filter((li) => availableLocales.includes(li.code) || li.code === locale)
  : allLangItems;
const currentLangItem = langItems.find((li) => li.code === locale) ?? allLangItems.find((li) => li.code === locale);

const footerCopy: Record<string, { site: string; family: string; utility: string; knowledge: string; sitemap: string; support: string }> = {
  en: { site: "Wiki", family: "OIYO family", utility: "Information", knowledge: "Knowledge index", sitemap: "Sitemap", support: "Support OIYO" },
  ko: { site: "위키", family: "OIYO 패밀리", utility: "안내", knowledge: "지식 목록", sitemap: "사이트맵", support: "OIYO 후원" },
  ja: { site: "ウィキ", family: "OIYOファミリー", utility: "ご案内", knowledge: "知識一覧", sitemap: "サイトマップ", support: "OIYOを支援" },
  zh: { site: "维基", family: "OIYO 系列", utility: "信息", knowledge: "知识索引", sitemap: "网站地图", support: "支持 OIYO" },
  fr: { site: "Wiki", family: "Famille OIYO", utility: "Informations", knowledge: "Index des connaissances", sitemap: "Plan du site", support: "Soutenir OIYO" },
  es: { site: "Wiki", family: "Familia OIYO", utility: "Información", knowledge: "Índice de conocimiento", sitemap: "Mapa del sitio", support: "Apoyar OIYO" },
};
const footerLabels = footerCopy[locale] ?? footerCopy.en;
const knowledgeMission = ({
  ko: "여러 전문 지식 도메인의 정보를 사람과 AI가 인용할 수 있게 정리합니다.",
  en: "A citable repository of specialist knowledge for people and AI systems.",
  ja: "複数の専門分野の知識を、人とAIが引用できる形で整理します。",
  zh: "整理多个专业知识领域的信息，供人类与 AI 系统引用。",
  fr: "Un dépôt de savoirs spécialisés, conçu pour être cité par les personnes et les systèmes d’IA.",
  es: "Un repositorio citable de conocimientos especializados para personas y sistemas de IA.",
} as Record<string, string>)[locale] ?? "A citable repository of specialist knowledge for people and AI systems.";
---

<html
  lang={BCP47[locale] ?? locale}
  class:list={["scroll-smooth", { "snap-y snap-mandatory": scrollSnapEnabled }]}
>
  <head>
    <SEO {title} {description} {image} {type} {pubDate} {updatedDate} {tags} {category} {author} {availableLocales} {track} {series} {definition} {noindex} />

    <!-- Mermaid diagram rendering (only executes if mermaid code blocks are present) -->
    <script type="module" is:inline>
      if (document.querySelector("code.language-mermaid")) {
        const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
        mermaid.initialize({ startOnLoad: false, theme: "neutral", securityLevel: "strict" });
        document.querySelectorAll("code.language-mermaid").forEach((el) => {
          const pre = el.parentElement;
          if (!pre) return;
          const div = document.createElement("div");
          div.className = "mermaid not-prose my-8";
          div.textContent = el.textContent;
          pre.replaceWith(div);
        });
        await mermaid.run();
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-background text-foreground font-sans antialiased text-pretty selection:bg-primary/20 selection:text-primary"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] bg-primary text-primary-foreground px-4 py-2 rounded-lg"
    >
      Skip to content
    </a>

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <header
      role="banner"
      class="sticky top-0 z-50 w-full border-b bg-background"
    >
      <div class="container flex h-16 items-center justify-between px-4">

        <!-- Schema.org structured data for navigation -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SiteNavigationElement",
          "hasPart": navItems.map(item => ({
            "@type": "WebPage",
            "name": item.label,
            "url": item.href.startsWith("http") ? item.href : `${siteConfig.url}${item.href}`,
          })),
        })} />

        <!-- Logo -->
        <a
          href={`/${locale}/`}
          class="flex items-center space-x-2 shrink-0 z-10"
          aria-label="Oiyo home"
        >
          <span class="font-black text-xl tracking-tighter text-foreground">OIYO</span>
          <span class="text-sm font-semibold lowercase tracking-wide text-primary">wiki</span>
        </a>

        <!-- Desktop nav (lg+) -->
        <nav
          aria-label="Main navigation"
          class="hidden lg:flex gap-6 items-center"
        >
          {navItems.slice(1).map(({ href, label }) => (
            <a
              href={href}
              class="text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
            >{label}</a>
          ))}

          <!-- Search -->
          <a
            href={`/${locale}/search`}
            class="flex items-center gap-1.5 text-sm font-bold uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary whitespace-nowrap"
            aria-label="Search"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>

          <!-- Language switcher: native <details>/<summary> disclosure — every
               locale stays a real static <a href> in the DOM (crawlable
               regardless of open/closed state), just visually collapsed. -->
          <details id="header-lang-switcher" class="relative border-l border-border/40 pl-4 group">
            <summary
              class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-widest text-muted-foreground/70 transition-colors hover:text-primary cursor-pointer list-none [&::-webkit-details-marker]:hidden"
              aria-label="Language"
            >
              <span aria-hidden="true">{currentLangItem?.flag}</span>{currentLangItem?.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <nav
              aria-label="Language"
              class="absolute right-0 top-full z-20 mt-2 flex min-w-[140px] flex-col gap-1 rounded-lg border border-border bg-background p-2 shadow-lg"
            >
              {langItems.map(({ code, label, flag, name }) => (
                <a
                  href={getLocalizedPath(code)}
                  class={`flex items-center gap-1.5 rounded-md px-2 py-1.5 text-[11px] font-bold uppercase tracking-widest transition-colors hover:bg-muted/60 hover:text-primary ${locale === code ? "text-primary" : "text-muted-foreground/70"}`}
                 aria-label={name} title={name}>{flag} {label}</a>
              ))}
            </nav>
          </details>
        </nav>

        <!-- Right controls: hamburger -->
        <div class="flex items-center gap-2">
          <!-- Mobile search -->
          <a
            href={`/${locale}/search`}
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
            aria-label="Search"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>

          <!-- Hamburger (mobile only) -->
          <button
            id="menu-open"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Reading progress — anchored to the header's bottom edge so it never floats over content -->
      <div
        id="reading-progress"
        class="absolute bottom-0 left-0 h-0.5 bg-primary transition-none"
        style="width: 0%"
        aria-hidden="true"
      ></div>
    </header>

    <!-- ── Mobile menu overlay ───────────────────────────────────────────── -->
    <div
      id="mobile-menu-overlay"
      class="fixed inset-0 z-[60] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-hidden="true"
    ></div>

    <!-- Mobile menu drawer (slides in from right) -->
    <div
      id="mobile-menu"
      role="dialog"
      aria-label="Navigation menu"
      aria-modal="true"
      class="fixed top-0 right-0 h-full w-72 max-w-[85vw] z-[70] bg-background border-l border-border shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
    >
      <!-- Drawer header -->
      <div class="flex items-center justify-between px-6 h-16 border-b border-border/40 shrink-0">
        <span class="font-black text-lg tracking-tighter">OIYO <span class="font-semibold lowercase text-primary">wiki</span></span>
        <button
          id="menu-close"
          aria-label="Close menu"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Nav links -->
      <nav aria-label="Mobile navigation" class="flex-1 overflow-y-auto px-6 py-6 space-y-1">
        {navItems.map(({ href, label }) => (
          <a
            href={href}
            class="flex items-center h-11 px-2 rounded-lg text-sm font-bold uppercase tracking-widest text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
          >{label}</a>
        ))}
        <div class="pt-2 border-t border-border/40 mt-4">
          <a
            href={`/${locale}/search`}
            class="flex items-center gap-3 h-11 px-2 rounded-lg text-sm font-bold uppercase tracking-widest text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Search
          </a>
        </div>
        <div class="pt-2 border-t border-border/40 mt-4">
          <p class="px-2 pt-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">Oiyo Family</p>
          {FAMILY.map((f) => (
            <a
              href={familyHref(f, "menu")}
              target="_blank" rel="noopener noreferrer"
              class="flex flex-col justify-center min-h-11 px-2 py-1.5 rounded-lg text-sm font-bold text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
            >
              <span class="uppercase tracking-widest">{f.name} ↗</span>
              <span class="text-[11px] font-normal normal-case tracking-normal opacity-70">{f.tag[locale as keyof typeof f.tag] ?? f.tag.en}</span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Language switcher at bottom -->
      <div class="px-6 pb-6 pt-4 border-t border-border/40 shrink-0">
        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50 mb-3">
          {t.common?.selectLanguage ?? "Language"}
        </p>
        <div class="flex flex-wrap gap-2">
          {langItems.map(({ code, label, flag, name }) => (
            <a
              href={getLocalizedPath(code)}
              class={`px-3 py-1.5 rounded-md text-xs font-bold uppercase tracking-widest border transition-colors ${locale === code ? "bg-primary text-primary-foreground border-primary" : "border-border text-muted-foreground hover:text-primary hover:border-primary/40"}`}
            ><span aria-hidden="true">{flag}</span>{name}</a>
          ))}
        </div>
      </div>
    </div>


    <!-- Interactive scripts (inline to avoid render-blocking) -->
    <script is:inline>
      // ── Reading progress ──────────────────────────────────────────────────
      (function () {
        var bar = document.getElementById("reading-progress");
        if (!bar) return;
        function update() {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var docHeight =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = Math.min(100, pct).toFixed(1) + "%";
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      })();

      // ── Back to top ──────────────────────────────────────────────────────
      (function () {
        var btn = document.getElementById("back-to-top");
        if (!btn) return;
        function toggleVisibility() {
          var show = window.scrollY > 400;
          btn.classList.toggle("opacity-0", !show);
          btn.classList.toggle("pointer-events-none", !show);
          btn.classList.toggle("opacity-100", show);
        }
        window.addEventListener("scroll", toggleVisibility, { passive: true });
        btn.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        toggleVisibility();
      })();

      // ── Language switcher: close on outside click / Escape ──────────────────
      (function () {
        var lang = document.getElementById("header-lang-switcher");
        if (!lang) return;
        document.addEventListener("click", function (e) {
          if (lang.open && !lang.contains(e.target)) lang.removeAttribute("open");
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && lang.open) lang.removeAttribute("open");
        });
      })();

      // ── Mobile menu ───────────────────────────────────────────────────────
      (function () {
        var openBtn   = document.getElementById("menu-open");
        var closeBtn  = document.getElementById("menu-close");
        var overlay   = document.getElementById("mobile-menu-overlay");
        var drawer    = document.getElementById("mobile-menu");
        if (!openBtn || !closeBtn || !overlay || !drawer) return;

        function openMenu() {
          drawer.classList.remove("translate-x-full");
          overlay.classList.remove("opacity-0", "pointer-events-none");
          overlay.classList.add("opacity-100");
          overlay.setAttribute("aria-hidden", "false");
          openBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          // Move focus into drawer
          var firstLink = drawer.querySelector("a, button");
          if (firstLink) firstLink.focus();
        }

        function closeMenu() {
          drawer.classList.add("translate-x-full");
          overlay.classList.add("opacity-0", "pointer-events-none");
          overlay.classList.remove("opacity-100");
          overlay.setAttribute("aria-hidden", "true");
          openBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          openBtn.focus();
        }

        openBtn.addEventListener("click", openMenu);
        closeBtn.addEventListener("click", closeMenu);
        overlay.addEventListener("click", closeMenu);

        // Escape key closes menu
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeMenu();
        });
      })();
    </script>

    <main id="main-content" role="main" class="flex-1">
      <slot />
    </main>

    <!-- Back to top button -->
    <button
      id="back-to-top"
      aria-label={t.common?.goToTop ?? "Go to top"}
      class="fixed bottom-6 right-6 z-40 h-10 w-10 rounded-full bg-primary text-primary-foreground shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200 hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <footer class="border-t border-border bg-muted/25 py-10 text-left">
      <div class="container grid gap-8 px-4 sm:grid-cols-2 lg:grid-cols-[0.8fr_1fr_2fr]">
        <section>
          <p class="mb-3 text-sm font-black tracking-tight">OIYO <span class="font-semibold lowercase text-primary">wiki</span></p>
          <p class="mb-3 max-w-xs text-xs leading-relaxed text-muted-foreground">{knowledgeMission}</p>
          <nav aria-label={footerLabels.site} class="grid gap-2 text-sm text-muted-foreground">
            {/*
              2026-08-17: courses(강의)·magazine(매거진) 링크를 뺐다. 당시 실제 canonical
              routes가 blog로 이전됐기 때문에 wiki 푸터에서도 제거했다. 2026-08-27부터
              콘텐츠 형식은 도메인을 강제하지 않지만, 이 링크 제거 결정은 그대로 유효하다.
            */}
            <a href={`/${locale}/explore`} class="hover:text-primary">{nav.explore ?? "Explore"}</a>
            <a href="/knowledge/" class="hover:text-primary">{footerLabels.knowledge}</a>
            <a href={`/${locale}/about`} class="hover:text-primary">{nav.about ?? "About"}</a>
          </nav>
        </section>
        <section>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-foreground">{footerLabels.utility}</p>
          <nav aria-label={footerLabels.utility} class="grid gap-2 text-sm text-muted-foreground">
            <a href={`/${locale}/privacy`} class="hover:text-primary">{t.legal.privacy.title}</a>
            <a href={`/${locale}/terms`} class="hover:text-primary">{t.legal.terms.title}</a>
            <a href="/rss.xml" class="hover:text-primary">RSS</a>
            <a href="/sitemap-index.xml" class="hover:text-primary">{footerLabels.sitemap}</a>
            <a href="https://paypal.me/chosean" target="_blank" rel="noopener noreferrer" class="hover:text-primary">{footerLabels.support}</a>
          </nav>
        </section>
        <section>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-foreground">{footerLabels.family}</p>
          <nav aria-label={footerLabels.family} class="grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-3">
            {FAMILY.map((f) => (
              <a href={familyHref(f, "footer")} class="group min-w-0 text-sm font-semibold text-foreground hover:text-primary">
                {f.name}
                <span class="block text-xs font-normal text-muted-foreground group-hover:text-primary/80">{f.tag[locale as keyof typeof f.tag] ?? f.tag.en}</span>
              </a>
            ))}
          </nav>
        </section>
      </div>
      <div class="container mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-border px-4 pt-5 text-xs text-muted-foreground">
        <span>© {new Date().getFullYear()} Oiyo Tech</span>
        <a href="mailto:support@oiyo.net" class="hover:text-primary">support@oiyo.net</a>
      </div>
    </footer>
    <AhoxyWelcome locale={locale} />
  </body>
</html>
