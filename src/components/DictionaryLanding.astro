    machineBody: "모든 항목은 DefinedTerm으로 표시되고, 전체 목록은 하나의 JSON으로 공개됩니다. AI와 검색엔진이 출처를 밝히고 인용할 수 있습니다.",
    machineCta: "topics.json 열기",
    siblingsTitle: "정의 다음에 필요한 것",
    blog: "설명 읽기",
    blogDesc: "왜 그런지, 사례와 학습 경로로",
    tools: "직접 해보기",
    toolsDesc: "계산기·차트·테스트로 내 경우를 확인",
  },
  en: {
    eyebrow: "Reference knowledge",
    title: (n) => `${n} terms, defined`,
    lede: "Saju, astrology, tarot and psychology terms, each starting from a one-sentence definition. Every entry names its reviewer and review date, and has a stable URL you can cite.",
    browse: "Browse by subject",
    terms: (n) => `${n.toLocaleString("en")} terms`,
    recentTitle: "Recently reviewed",
    recentNote: "The review date is when a person checked the entry again.",
    machineTitle: "A dictionary machines can read",
    machineBody: "Every entry is marked up as a DefinedTerm, and the whole set is published as one JSON file, so search engines and AI can cite it with attribution.",
    machineCta: "Open topics.json",
    siblingsTitle: "After the definition",
    blog: "Read the explanation",
    blogDesc: "Why it works that way, with examples",
    tools: "Try it yourself",
    toolsDesc: "Calculators, charts and tests for your own case",
  },
