  fr: {
    eyebrow: "Couche de définition",
    title: (n) => `${n} termes, définis`,
    lede: "Termes de saju, d'astrologie, de tarot et de psychologie, chacun partant d'une définition d'une phrase. Chaque entrée indique son relecteur et sa date de relecture, avec une URL stable à citer.",
    browse: "Parcourir par sujet",
    terms: (n) => `${n.toLocaleString("fr")} termes`,
    recentTitle: "Relu récemment",
    recentNote: "La date de relecture est celle où une personne a revérifié l'entrée.",
    machineTitle: "Un dictionnaire lisible par les machines",
