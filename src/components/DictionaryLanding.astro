  es: {
    eyebrow: "Capa de definición",
    title: (n) => `${n} términos, definidos`,
    lede: "Términos de saju, astrología, tarot y psicología, cada uno a partir de una definición de una frase. Cada entrada indica su revisor y la fecha de revisión, con una URL estable para citar.",
    browse: "Explorar por tema",
    terms: (n) => `${n.toLocaleString("es")} términos`,
    recentTitle: "Revisado recientemente",
    recentNote: "La fecha de revisión es cuando una persona volvió a comprobar la entrada.",
    machineTitle: "Un diccionario que las máquinas leen",
    machineBody: "Cada entrada se marca como DefinedTerm y el conjunto se publica en un solo JSON, de modo que buscadores e IA puedan citarlo con atribución.",
    machineCta: "Abrir topics.json",
    siblingsTitle: "Después de la definición",
    blog: "Leer la explicación",
    blogDesc: "Por qué es así, con ejemplos",
    tools: "Probarlo",
    toolsDesc: "Calculadoras, cartas y tests para tu caso",
  },
};

const c = COPY[locale] ?? COPY.en;
const formatted = termCount.toLocaleString(locale === "ko" ? "ko" : locale);
const pageTitle = c.title(formatted);
---

<BaseLayout title={pageTitle} description={c.lede} availableLocales={availableLocales}>
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <p class="text-sm font-medium text-primary mb-3">{c.eyebrow}</p>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-5 font-heading">
        {pageTitle}
      </h1>
      {/* keep-all stops Korean and Chinese from breaking inside a word, which
          the default break-all does — "밝히 / 고," in the first render. */}
      <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed [word-break:keep-all]">
        {c.lede}
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="container px-4">
      <h2 class="text-2xl font-bold mb-6 font-heading">{c.browse}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="block rounded-xl border border-border/60 p-5 transition hover:border-primary/60 hover:bg-muted/40"
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="font-semibold">{cat.label}</span>
              <span class="text-sm text-muted-foreground whitespace-nowrap">{c.terms(cat.count)}</span>
            </div>
            {cat.sample.length > 0 && (
              <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                {cat.sample.join(" · ")}
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="pb-16">
      <div class="container px-4">
        <h2 class="text-2xl font-bold mb-2 font-heading">{c.recentTitle}</h2>
        <p class="text-sm text-muted-foreground mb-6">{c.recentNote}</p>
        <ul class="divide-y divide-border/60">
          {recent.map((r) => (
            <li class="py-4">
              <a href={r.href} class="font-medium hover:text-primary">{r.title}</a>
              {r.reviewedDate && (
                <span class="ml-2 text-xs text-muted-foreground">{r.reviewedDate}</span>
              )}
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{r.definition}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="pb-20">
    <div class="container px-4 grid gap-6 lg:grid-cols-3">
      <div class="rounded-xl border border-border/60 p-6 lg:col-span-1">
        <h2 class="text-lg font-bold mb-2 font-heading">{c.machineTitle}</h2>
        <p class="text-sm text-muted-foreground leading-relaxed mb-4">{c.machineBody}</p>
        <a href="/knowledge/topics.json" class="text-sm font-medium text-primary hover:underline">
          {c.machineCta} →
        </a>
      </div>

      <div class="lg:col-span-2">
        <h2 class="text-lg font-bold mb-4 font-heading">{c.siblingsTitle}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <a
            href={`https://blog.oiyo.net/${locale}/`}
            class="block rounded-xl border border-border/60 p-5 transition hover:border-primary/60 hover:bg-muted/40"
          >
            <span class="font-semibold">{c.blog}</span>
            <p class="mt-1 text-sm text-muted-foreground">{c.blogDesc}</p>
          </a>
          <a
            href={`https://oiyo.net/${locale}/`}
            class="block rounded-xl border border-border/60 p-5 transition hover:border-primary/60 hover:bg-muted/40"
          >
            <span class="font-semibold">{c.tools}</span>
            <p class="mt-1 text-sm text-muted-foreground">{c.toolsDesc}</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
