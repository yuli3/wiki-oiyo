---
/**
 * The front door for Wiki reference and dictionary routes.
 *
 * Until 2026-08-14 this site's landing page rendered the same component as
 * blog.oiyo.net with the same category grid, so both homes carried the h1 "홈",
 * the same description, and a shelf of links to calculators, psychology tests
 * and puzzle games. Two sites, one front door, and neither of them said what
 * this one is: the place where terms are defined.
 *
 * The machine-facing half of that identity already existed — /knowledge/topics.json
 * publishes a DefinedTermSet and every dictionary entry emits DefinedTerm — so
 * this page gives the human half the same claim: how many terms, in what
 * subjects, reviewed when, and a way in.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Category {
  key: string;
  label: string;
  count: number;
  href: string;
  sample: string[];
}

interface Props {
  locale: Locale;
  termCount: number;
  categories: Category[];
  recent: { title: string; href: string; definition: string; reviewedDate?: string }[];
  availableLocales?: string[];
}

const { locale, termCount, categories, recent, availableLocales } = Astro.props;
const t = await getTranslations(locale);

type Copy = {
  eyebrow: string;
  title: (n: string) => string;
  lede: string;
  browse: string;
  terms: (n: number) => string;
  recentTitle: string;
  recentNote: string;
  machineTitle: string;
  machineBody: string;
  machineCta: string;
  siblingsTitle: string;
  blog: string;
  blogDesc: string;
  tools: string;
  toolsDesc: string;
};

const COPY: Record<Locale, Copy> = {
  ko: {
    eyebrow: "정의 계층",
