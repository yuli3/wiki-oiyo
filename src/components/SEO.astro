---
import { siteConfig } from "../config/site.config";
import { getAuthor } from "../lib/authors";
import deindexedLocales from "../config/deindexed-locales.json";

// Crawl-budget policy — see astro.config.mjs. Reachable for users, out of the
// index, the sitemap, and the hreflang cluster.
const DEINDEXED_LOCALES = new Set<string>(deindexedLocales);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  availableLocales?: string[];
  // Search-result pages must stay out of the index (Google quality guidelines).
  noindex?: boolean;
  track?: string;
  series?: string;
  definition?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = `${siteConfig.url}/og-image.png`,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = "website",
  pubDate,
  updatedDate,
  tags,
  category,
  author = siteConfig.author,
  availableLocales,
  noindex = false,
  track,
  series,
  definition,
} = Astro.props;

const siteTitle =
  title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;

// Multilingual Hreflang logic
// availableLocales: restrict hreflang to locales that actually have content.
// Pages generated from the full locale list (home, static tool/listing slugs
// at /{locale}/{slug}/) fall back to all site locales. Pagination
// (/{locale}/119/) and deeper dynamic routes (category pages) vary per
// locale, so they stay self-referential.
const currentPathname = Astro.url.pathname;
const pathSegments = currentPathname.split("/").filter(Boolean);
const currentLocaleSegment = siteConfig.locales.includes(pathSegments[0])
  ? pathSegments[0]
  : siteConfig.locale;
const isLocaleCompleteRoute =
  siteConfig.locales.includes(pathSegments[0]) &&
  (pathSegments.length === 1 ||
    (pathSegments.length === 2 && !/^\d+$/.test(pathSegments[1])));
const allLocales =
  availableLocales ??
  (isLocaleCompleteRoute ? siteConfig.locales : [currentLocaleSegment]);
// Deindexed locales are dropped from the hreflang cluster: Google discards
// hreflang annotations pointing at noindex URLs.
const locales = allLocales.filter((l: string) => !DEINDEXED_LOCALES.has(l));
const isDeindexedLocale = DEINDEXED_LOCALES.has(currentLocaleSegment);
const robotsContent = noindex || isDeindexedLocale
  ? "noindex, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Helper to generate localized URLs
const getLocalizedUrl = (locale: string) => {
  const firstSegment = currentPathname.split("/")[1];
  // Locale-less pages (e.g. /knowledge) have no per-locale variants — keep the
  // alternate self-referential rather than inventing a non-existent /xx/ URL.
  if (!siteConfig.locales.includes(firstSegment)) {
    return new URL(currentPathname, Astro.site);
  }
  const restOfPath = currentPathname.replace(`/${firstSegment}`, "") || "/";

  const localizedPath = restOfPath === "/"
    ? `/${locale}/`
    : `/${locale}${restOfPath}`;

  return new URL(localizedPath, Astro.site);
};

const googleAnalyticsId = siteConfig.analytics.googleAnalyticsId;
const googleAdsenseId = siteConfig.analytics.googleAdsenseId;

// BCP-47 locale mapping for hreflang tags
const hreflangMap: Record<string, string> = {
  en: "en", ko: "ko", ja: "ja", fr: "fr", es: "es",
  zh: "zh-CN",
};

const xDefaultLocale = locales.includes("en") ? "en" : (locales[0] ?? siteConfig.locale);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={siteConfig.themeColor} />
<meta name="naver-site-verification" content="e1043bad51e3be143affbe491f12354fa985fa6a" />

<!-- Robots & Indexing -->
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />
<meta name="bingbot" content={robotsContent} />

<!-- Preconnect to external origins -->
{googleAnalyticsId && (
  <link rel="preconnect" href="https://www.googletagmanager.com" />
)}
{googleAdsenseId && (
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
  <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
)}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

{googleAnalyticsId && (
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
  <script is:inline define:vars={{ googleAnalyticsId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', googleAnalyticsId);
  </script>
)}

{googleAdsenseId && (
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${googleAdsenseId}`}
     crossorigin="anonymous"></script>
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Multilingual SEO (Hreflang) -->
{
  locales.map((locale) => (
    <link rel="alternate" hreflang={hreflangMap[locale] ?? locale} href={getLocalizedUrl(locale)} />
  ))
}
<link rel="alternate" hreflang="x-default" href={getLocalizedUrl(xDefaultLocale)} />

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
{tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:width" content="1200" />}
{image && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
<!-- og:locale uses BCP-47 with underscore notation -->
<meta property="og:locale" content={(hreflangMap[Astro.url.pathname.split("/")[1]] ?? "en").replace("-", "_")} />

<!-- Article-specific Open Graph meta tags -->
{type === "article" && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === "article" && (updatedDate ?? pubDate) && (
  <meta property="article:modified_time" content={(updatedDate ?? pubDate)!.toISOString()} />
)}
{type === "article" && (
  <meta property="article:author" content={`${siteConfig.url}/en/about`} />
)}
{type === "article" && category && (
  <meta property="article:section" content={category} />
)}
{type === "article" && tags && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}
{image && <meta property="twitter:image:alt" content={title} />}
{
  siteConfig.seo.twitterHandle && (
    <meta property="twitter:site" content={siteConfig.seo.twitterHandle} />
  )
}
{
  siteConfig.seo.twitterHandle && (
    <meta property="twitter:creator" content={siteConfig.seo.twitterHandle} />
  )
}

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteConfig.title}
  href="/rss.xml"
/>

<!-- Knowledge catalog (machine-citable data foundation) -->
<link
  rel="alternate"
  type="application/json"
  title="Knowledge Catalog"
  href="/knowledge/index.json"
/>

<!-- JSON-LD Schemas -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": siteConfig.seo.organization.id,
    name: siteConfig.seo.organization.name,
    url: siteConfig.seo.organization.canonicalUrl,
    logo: siteConfig.seo.organization.logo,
    ...(siteConfig.seo.organization.sameAs.length ? { sameAs: siteConfig.seo.organization.sameAs } : {}),
  })}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
    publisher: {
      "@id": siteConfig.seo.organization.id,
    },
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteConfig.url}/en/search?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  })}
/>

<!-- Breadcrumb Schema -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: (() => {
      // locale segments are routing noise, and the final crumb should carry
      // the real page title, not a prettified raw slug (#16)
      const localeSegs = new Set(["en", "ko", "ja", "zh", "fr", "es"]);
      const all = Astro.url.pathname.split("/").filter(Boolean);
      const crumbs = all
        .map((segment, index) => ({ segment, path: "/" + all.slice(0, index + 1).join("/") }))
        .filter(({ segment }, index) => !(index === 0 && localeSegs.has(segment)));
      return [
        { "@type": "ListItem", position: 1, name: "Home", item: siteConfig.url },
        ...crumbs.map(({ segment, path }, i) => ({
          "@type": "ListItem",
          position: i + 2,
          name:
            i === crumbs.length - 1 && title
              ? title
              : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " "),
          item: new URL(path, Astro.site),
        })),
      ];
    })(),
  })}
/>

{
  type === "article" && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        ...(image ? { image: [new URL(image, Astro.url)] } : {}),
        datePublished: pubDate
          ? pubDate.toISOString()
          : new Date().toISOString(),
        dateModified: updatedDate
          ? updatedDate.toISOString()
          : pubDate
            ? pubDate.toISOString()
            : new Date().toISOString(),
        author: {
          "@type": getAuthor(author).schemaType,
          name: author,
          url: `${siteConfig.url}/about`,
        },
        publisher: {
          "@type": "Organization",
          "@id": siteConfig.seo.organization.id,
          name: siteConfig.seo.organization.name,
          logo: {
            "@type": "ImageObject",
            url: siteConfig.seo.organization.logo,
          },
        },
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url,
        },
      })}
    />
  )
}

{
  /* DefinedTerm: marks dictionary entries as machine-recognizable defined terms
     so they are citable by search and AI as canonical definitions. */
  track === "dictionary" && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "DefinedTerm",
        "@id": `${canonicalURL}#term`,
        name: title,
        description: definition ?? description,
        url: canonicalURL.toString(),
        inLanguage: hreflangMap[currentLocaleSegment] ?? currentLocaleSegment,
        inDefinedTermSet: {
          "@type": "DefinedTermSet",
          // series frontmatter는 고정 enum(한국어)이라 로케일 표기로 변환해 발행
          // (감사: 비한국어 정의가 한국어 시리즈명으로 인덱싱되는 AIEO 문제)
          name: (() => {
            const SERIES_I18N: Record<string, Record<string, string>> = {
              "점성술 대사전": { en: "Astrology Encyclopedia", ja: "占星術大事典", zh: "占星术大辞典", fr: "Encyclopédie de l'astrologie", es: "Enciclopedia de astrología" },
              "사주 대사전": { en: "Saju (Four Pillars) Encyclopedia", ja: "四柱推命大事典", zh: "四柱八字大辞典", fr: "Encyclopédie du Saju", es: "Enciclopedia del Saju" },
              "신화 인물 사전": { en: "Mythological Figures Dictionary", ja: "神話人物事典", zh: "神话人物辞典", fr: "Dictionnaire des figures mythologiques", es: "Diccionario de figuras mitológicas" },
              "타로 대사전": { en: "Tarot Encyclopedia", ja: "タロット大事典", zh: "塔罗大辞典", fr: "Encyclopédie du tarot", es: "Enciclopedia del tarot" },
              "꿈해몽 사전": { en: "Dream Interpretation Dictionary", ja: "夢占い事典", zh: "解梦辞典", fr: "Dictionnaire des rêves", es: "Diccionario de sueños" },
              "24절기 사전": { en: "24 Solar Terms Dictionary", ja: "二十四節気事典", zh: "二十四节气辞典", fr: "Dictionnaire des 24 termes solaires", es: "Diccionario de los 24 términos solares" },
              "MBTI 사전": { en: "MBTI Dictionary", ja: "MBTI事典", zh: "MBTI 辞典", fr: "Dictionnaire MBTI", es: "Diccionario MBTI" },
            };
            const base = series ?? category ?? `${siteConfig.name} Knowledge Catalog`;
            return SERIES_I18N[base]?.[currentLocaleSegment] ?? base;
          })(),
          url: `${siteConfig.url}/knowledge/topics.json`,
        },
      })}
    />
  )
}
