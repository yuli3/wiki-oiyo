---
interface ChapterPost {
  slug: string;
  data: { title: string };
}

interface Props {
  seriesPosts: ChapterPost[];
  currentChapter: number;
  locale: string;
  seriesName: string;
  coursesHref: string;
}

const { seriesPosts, currentChapter, locale, seriesName, coursesHref } = Astro.props;
const total = seriesPosts.length;

const copy: Record<string, { contents: string; courses: string; chapter: string }> = {
  en: { contents: "Contents", courses: "Explore", chapter: "Chapter" },
  ko: { contents: "목차", courses: "탐색", chapter: "챕터" },
  ja: { contents: "目次", courses: "探索", chapter: "章" },
  zh: { contents: "目录", courses: "探索", chapter: "章节" },
  fr: { contents: "Sommaire", courses: "Explorer", chapter: "Chapitre" },
  es: { contents: "Contenido", courses: "Explorar", chapter: "Capítulo" },
};
const labels = copy[locale] ?? copy.en;

const chapterLinks = seriesPosts.map((post) => {
  const number = parseInt(post.slug.match(/-ch(\d+)$/)?.[1] ?? "0", 10);
  return {
    number,
    title: post.data.title.replace(/^Ch\.?\s*\d+[.:]?\s*/i, ""),
    href: `/${locale}/${post.slug.split("/").slice(1).join("/")}/`,
    current: number === currentChapter,
  };
});
---

<aside data-document-nav class="text-sm" aria-label={labels.contents}>
  <details class="border-y border-border py-3 lg:hidden">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 font-semibold text-foreground">
      <span>{labels.chapter} {currentChapter} / {total}</span>
      <span class="text-xs font-bold uppercase tracking-widest text-primary">{labels.contents}</span>
    </summary>
    <nav class="mt-3 max-h-[55vh] overflow-y-auto border-t border-border pt-3" aria-label={labels.contents}>
      <a href={coursesHref} class="mb-3 block text-xs font-semibold text-primary underline underline-offset-4">← {labels.courses}</a>
      <ol class="space-y-1">
        {chapterLinks.map((chapter) => (
          <li>
            <a
              href={chapter.href}
              aria-current={chapter.current ? "page" : undefined}
              class:list={[
                "flex min-h-11 items-start gap-3 border-l-2 px-3 py-2 leading-snug",
                chapter.current
                  ? "border-primary bg-primary/8 font-bold text-foreground"
                  : "border-transparent text-muted-foreground hover:border-primary/30 hover:bg-primary/5 hover:text-foreground",
              ]}
            >
              <span class="w-6 shrink-0 text-xs font-bold text-primary">{chapter.number}</span>
              <span>{chapter.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>

  <nav class="hidden lg:block" aria-label={labels.contents}>
    <a href={coursesHref} class="mb-4 block text-xs font-semibold text-primary hover:underline">← {labels.courses}</a>
    <p class="border-b border-border pb-3 font-bold leading-snug text-foreground">{seriesName}</p>
    <p class="py-3 text-[11px] font-bold uppercase tracking-widest text-primary">{labels.contents}</p>
    <ol class="max-h-[65vh] space-y-0.5 overflow-y-auto pr-2">
      {chapterLinks.map((chapter) => (
        <li>
          <a
            href={chapter.href}
            aria-current={chapter.current ? "page" : undefined}
            class:list={[
              "flex min-h-10 items-start gap-2 border-l-2 px-3 py-2 text-[12px] leading-snug",
              chapter.current
                ? "border-primary bg-primary/8 font-bold text-foreground"
                : "border-transparent text-muted-foreground hover:border-primary/30 hover:bg-primary/5 hover:text-foreground",
            ]}
          >
            <span class="w-5 shrink-0 font-bold text-primary">{chapter.number}</span>
            <span>{chapter.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
