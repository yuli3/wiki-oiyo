---
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  itemName: string;
  targetPath: string;
  kind: "test" | "calculator" | "tool";
}

const { locale, itemName, targetPath, kind } = Astro.props;
const targetLocale = locale === "cn" ? "zh" : locale;
const target = `https://oiyo.net/${targetLocale}${targetPath}`;

const copy: Record<Locale, { moved: string; body: string; link: string; test: string; calculator: string; tool: string }> = {
  ko: {
    moved: "oiyo.net에서 진행합니다",
    body: "wiki.oiyo.net은 뜻과 개념을 설명하고, 실제 실행형 도구는 oiyo.net의 정본 페이지로 통합했습니다.",
    link: "oiyo.net에서 열기",
    test: "테스트",
    calculator: "계산기",
    tool: "도구",
  },
  en: {
    moved: "now lives on oiyo.net",
    body: "wiki.oiyo.net defines the concepts. The interactive tool is unified on the canonical oiyo.net page.",
    link: "Open on oiyo.net",
    test: "test",
    calculator: "calculator",
    tool: "tool",
  },
  ja: {
    moved: "は oiyo.net に移動しました",
    body: "wiki.oiyo.net は意味と概念を説明し、実行型ツールは oiyo.net の正本ページに統合しました。",
    link: "oiyo.netで開く",
    test: "テスト",
    calculator: "計算機",
    tool: "ツール",
  },
  fr: {
    moved: "est sur oiyo.net",
    body: "wiki.oiyo.net définit les concepts. L'outil interactif est unifié sur la page canonique oiyo.net.",
    link: "Ouvrir sur oiyo.net",
    test: "test",
    calculator: "calculateur",
    tool: "outil",
  },
  es: {
    moved: "está en oiyo.net",
    body: "wiki.oiyo.net define los conceptos. La herramienta interactiva está unificada en la página canónica de oiyo.net.",
    link: "Abrir en oiyo.net",
    test: "test",
    calculator: "calculadora",
    tool: "herramienta",
  },
  zh: {
    moved: "已移至 oiyo.net",
    body: "wiki.oiyo.net 负责概念定义，互动工具统一到 oiyo.net 的规范页面。",
    link: "在 oiyo.net 打开",
    test: "测试",
    calculator: "计算器",
    tool: "工具",
  },
  cn: {
    moved: "已移至 oiyo.net",
    body: "wiki.oiyo.net 負責概念定義，互動工具統一到 oiyo.net 的規範頁面。",
    link: "在 oiyo.net 開啟",
    test: "測試",
    calculator: "計算機",
    tool: "工具",
  },
};

const text = copy[locale] ?? copy.en;
const kindLabel = text[kind];
const title = `${itemName} ${kindLabel} ${text.moved}`;
---
<html lang={locale}>
  <head>
    <title>{title}</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <main style="font-family: system-ui, sans-serif; max-width: 42rem; margin: 4rem auto; padding: 0 1rem;">
      <h1>{title}</h1>
      <p>{text.body}</p>
      <p><a href={target}>{text.link}</a></p>
    </main>
  </body>
</html>
