---
/**
 * Hand-placed AdSense units for OIYO Wiki, alongside Auto ads (세운 결정 2026-10-17: 하이브리드 전환).
 *
 * Places a clean, responsive display unit strictly AFTER the reader has finished the
 * academy chapter / document, right above the next-chapter navigation.
 *
 * Ensures:
 * 1) Placed only after reading value has been delivered.
 * 2) Height reservation (min-h-72) to prevent Cumulative Layout Shift (CLS).
 * 3) IntersectionObserver lazy loading (loads only within 300px of viewport to protect viewability).
 * 4) MutationObserver auto-hiding when AdSense returns 'unfilled'.
 * 5) Localized '광고 / Advertisement' disclaimer.
 */
import { siteConfig } from "../../config/site.config";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props as Props;

const config = siteConfig.manualAds;
const client = siteConfig.analytics.googleAdsenseId;

const LABEL: Record<Locale, string> = {
  ko: "광고",
  en: "Advertisement",
  ja: "広告",
  zh: "广告",
  fr: "Publicité",
  es: "Publicidad",
};

const payload = JSON.stringify({
  client,
  slots: config.slots,
  label: LABEL[locale] ?? LABEL.en,
});

const active = config.enabled && Boolean(client) && !noindex;
---

{active && (
  <script is:inline set:html={`(function(){
  var cfg=${payload};
  var host=location.hostname;
  var preview=false;try{preview=localStorage.getItem("oiyo:ads-preview")==="1"}catch(e){}
  if(!/(^|\\.)oiyo\\.net$/.test(host)&&!preview)return;
  var units=[];
  function box(name,slot){
    if(!slot&&!preview)return null;
    var wrap=document.createElement("aside");
    wrap.className="not-prose my-10 min-h-72 rounded-2xl border border-border bg-card/60 p-3 shadow-xs max-w-3xl mx-auto";
    wrap.setAttribute("data-manual-ad",name);
    wrap.setAttribute("aria-label",cfg.label);
    var tag=document.createElement("p");
    tag.className="mb-1 text-center text-xs text-muted-foreground";
    tag.textContent=cfg.label;
    var ins=document.createElement("ins");
    ins.className="adsbygoogle block";
    ins.setAttribute("data-ad-client",cfg.client);
    if(slot)ins.setAttribute("data-ad-slot",slot);
    ins.setAttribute("data-ad-format","auto");
    ins.setAttribute("data-full-width-responsive","true");
    wrap.appendChild(tag);wrap.appendChild(ins);units.push(wrap);
    if("MutationObserver" in window){
      new MutationObserver(function(){
        if(ins.getAttribute("data-ad-status")==="unfilled")wrap.hidden=true;
      }).observe(ins,{attributes:true,attributeFilter:["data-ad-status"]});
    }
    return wrap;
  }
  var main=document.getElementById("main-content");
  if(!main)return;
  var prose=main.querySelector(".prose, [data-document-shell]");
  // 2026-11-06: expand only substantial reading pages, never interactive islands.
  // Existing charts/tables/forms stay intact; insert at a direct prose heading boundary.
  if(prose&&!prose.querySelector("astro-island,form,input,textarea,select")&&prose.textContent.trim().length>=4000){
    var headings=Array.from(prose.querySelectorAll(":scope > h2"));
    if(headings.length>=5){
      var anchor=headings[Math.floor(headings.length/2)];
      var start=prose.getBoundingClientRect().top;
      var end=prose.getBoundingClientRect().bottom;
      var y=anchor.getBoundingClientRect().top;
      if(y-start>=600&&end-y>=600&&!anchor.previousElementSibling?.querySelector(".adsbygoogle")){
        var mid=box("wiki-article-mid",cfg.slots.articleMid);
        if(mid)anchor.parentNode.insertBefore(mid,anchor);
      }
    }
  }
  var target=box("wiki-article-end",cfg.slots.articleEnd);
  if(target){
    if(prose){
      prose.parentNode.insertBefore(target,prose.nextSibling);
    }else{
      main.appendChild(target);
    }
  }
  if(!units.length)return;
  function fill(el){try{(window.adsbygoogle=window.adsbygoogle||[]).push({})}catch(e){}el.setAttribute("data-manual-ad-requested","1")}
  if(!("IntersectionObserver" in window)){units.forEach(fill);return}
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting)return;
      var el=e.target;
      if(el.getAttribute("data-manual-ad-requested"))return;
      fill(el);
      io.unobserve(el);
    });
  },{rootMargin:"300px 0px"});
  units.forEach(function(u){io.observe(u)});
})()`} />
)}
