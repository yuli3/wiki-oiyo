---
/**
 * 체감온도 실시간 산정기 (WindChillSlider)
 *
 * 기상청 공식 겨울철 체감온도 공식(JAG/TI 모델)과 여름철 열지수(Heat Index)를 기반으로
 * 기온, 풍속, 습도 변화에 따른 실제 인체 열손실 및 온열 스트레스를 실시간으로 계산합니다.
 */
---

<div class="not-prose my-8 rounded-xl border border-border bg-card p-4 sm:p-6 shadow-xs" id="wind-chill-root">
  <div class="mb-5">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
      <h3 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">
        기상청 체감온도(대류 열손실·습구 온열지수) 실시간 계산기
      </h3>
    </div>
    <p class="mt-1 text-xs text-muted-foreground sm:text-sm">
      기온, 풍속, 습도를 조절하면 인체가 실제로 피부와 호흡기를 통해 체감하는 온도가 즉각 산출됩니다.
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <!-- Controls -->
    <div class="space-y-4 rounded-lg border border-border/60 bg-muted/20 p-4">
      <div>
        <div class="flex justify-between text-xs font-semibold text-foreground">
          <label for="temp-slider">기온 (℃)</label>
          <span id="temp-val" class="font-mono text-primary">-5 ℃</span>
        </div>
        <input
          type="range"
          id="temp-slider"
          min="-20"
          max="40"
          value="-5"
          step="1"
          class="mt-2 w-full accent-primary"
        />
        <div class="flex justify-between text-xs text-muted-foreground">
          <span>-20℃</span>
          <span>0℃</span>
          <span>20℃</span>
          <span>40℃</span>
        </div>
      </div>

      <div>
        <div class="flex justify-between text-xs font-semibold text-foreground">
          <label for="wind-slider">풍속 (m/s) — 겨울철 체감 지배요인</label>
          <span id="wind-val" class="font-mono text-primary">5.0 m/s</span>
        </div>
        <input
          type="range"
          id="wind-slider"
          min="0"
          max="20"
          value="5"
          step="0.5"
          class="mt-2 w-full accent-primary"
        />
        <div class="flex justify-between text-xs text-muted-foreground">
          <span>0 (무풍)</span>
          <span>5 (산들바람)</span>
          <span>10 (된바람)</span>
          <span>20 (강풍)</span>
        </div>
      </div>

      <div>
        <div class="flex justify-between text-xs font-semibold text-foreground">
          <label for="humidity-slider">상대습도 (%) — 여름철 증발 저해요인</label>
          <span id="humidity-val" class="font-mono text-primary">50 %</span>
        </div>
        <input
          type="range"
          id="humidity-slider"
          min="10"
          max="100"
          value="50"
          step="5"
          class="mt-2 w-full accent-primary"
        />
        <div class="flex justify-between text-xs text-muted-foreground">
          <span>10% (건조)</span>
          <span>50% (쾌적)</span>
          <span>80% (다습)</span>
          <span>100%</span>
        </div>
      </div>
    </div>

    <!-- Output Display -->
    <div class="flex flex-col justify-between rounded-lg border border-border bg-background p-5 text-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
          산출된 체감온도
        </p>
        <div class="my-3 flex items-baseline justify-center gap-1">
          <span id="result-temp" class="text-5xl font-black tracking-tight text-foreground font-mono sm:text-6xl">
            -11.4
          </span>
          <span class="text-2xl font-bold text-muted-foreground">℃</span>
        </div>
        <div class="mt-2 flex justify-center">
          <span
            id="danger-badge"
            class="inline-flex items-center rounded-md border border-warning/30 bg-warning/10 px-3 py-1 text-xs font-bold text-warning"
          >
            주의: 장시간 노출 시 저체온증 유의
          </span>
        </div>
      </div>

      <div class="mt-4 border-t border-border/60 pt-3 text-left text-xs text-muted-foreground">
        <p class="font-medium text-foreground">공학 산정 원리:</p>
        <p id="formula-desc" class="mt-1 leading-relaxed">
          겨울철(10℃ 이하)에는 바람에 의한 피부 표면 대류 열손실(JAG/TI 공식)을 적용하며, 풍속 1.3m/s 이상에서 급격히 하강합니다.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function setupWindChill() {
    const root = document.getElementById("wind-chill-root");
    if (!root) return;

    const tempSlider = root.querySelector<HTMLInputElement>("#temp-slider");
    const windSlider = root.querySelector<HTMLInputElement>("#wind-slider");
    const humSlider = root.querySelector<HTMLInputElement>("#humidity-slider");

    const tempVal = root.querySelector<HTMLElement>("#temp-val");
    const windVal = root.querySelector<HTMLElement>("#wind-val");
    const humVal = root.querySelector<HTMLElement>("#humidity-val");

    const resultTemp = root.querySelector<HTMLElement>("#result-temp");
    const dangerBadge = root.querySelector<HTMLElement>("#danger-badge");
    const formulaDesc = root.querySelector<HTMLElement>("#formula-desc");

    function calc() {
      if (!tempSlider || !windSlider || !humSlider || !resultTemp || !dangerBadge || !formulaDesc) return;

      const T = parseFloat(tempSlider.value);
      const W = parseFloat(windSlider.value); // m/s
      const H = parseFloat(humSlider.value); // %

      if (tempVal) tempVal.textContent = `${T} ℃`;
      if (windVal) windVal.textContent = `${W.toFixed(1)} m/s`;
      if (humVal) humVal.textContent = `${H} %`;

      let apparent = T;
      let badgeText = "쾌적/보통: 일상적 야외활동 가능";
      let badgeClass = "border-primary/20 bg-primary/10 text-primary";
      let desc = "";

      if (T <= 10) {
        // 겨울철 기상청 체감온도 공식 (JAG/TI 모델, W in km/h)
        const V = W * 3.6; // m/s -> km/h
        if (V >= 4.8) {
          const vPow = Math.pow(V, 0.16);
          apparent = 13.12 + 0.6215 * T - 11.37 * vPow + 0.3965 * T * vPow;
        } else {
          apparent = T;
        }
        desc = "겨울철 기상청 공식(JAG/TI 모델): 바람이 피부 표면 열을 빼앗아가는 대류 냉각 효과가 반영되었습니다.";

        if (apparent <= -25) {
          badgeText = "경고: 노출 피부 10분 내 동상 위험 (외출 자제)";
          badgeClass = "border-destructive bg-destructive/10 text-destructive";
        } else if (apparent <= -10) {
          badgeText = "주의: 방한복 착용 및 장시간 노출 시 저체온증 유의";
          badgeClass = "border-warning/30 bg-warning/10 text-warning";
        } else if (apparent <= 0) {
          badgeText = "관심: 쌀쌀한 날씨, 보온에 신경 쓰세요";
          badgeClass = "border-border bg-muted text-muted-foreground";
        }
      } else {
        // 여름철 체감온도 (단순화 열지수 모델: 습도로 인한 땀 증발 저해)
        // Rothfusz 회귀식 단순 모델
        const vaporPressure = (H / 100) * 6.105 * Math.exp((17.27 * T) / (237.7 + T));
        apparent = T + 0.33 * vaporPressure - 0.7 * W - 4.0;
        desc = "여름철 온열지수 모델: 높은 습도로 인해 땀이 증발하지 못해 피부 온도가 기온보다 높게 느껴집니다.";

        if (apparent >= 35) {
          badgeText = "폭염 경보 수준: 한낮 야외 작업 중단 권고";
          badgeClass = "border-destructive bg-destructive/10 text-destructive";
        } else if (apparent >= 33) {
          badgeText = "폭염 주의보 수준: 충분한 수분 섭취 및 온열질환 주의";
          badgeClass = "border-warning/30 bg-warning/10 text-warning";
        } else if (apparent >= 28) {
          badgeText = "약간 더움: 통풍이 잘되는 옷 착용 권장";
          badgeClass = "border-border bg-muted text-foreground";
        }
      }

      resultTemp.textContent = apparent.toFixed(1);
      dangerBadge.textContent = badgeText;
      dangerBadge.className = `inline-flex items-center rounded-md border px-3 py-1 text-xs font-bold ${badgeClass}`;
      formulaDesc.textContent = desc;
    }

    tempSlider?.addEventListener("input", calc);
    windSlider?.addEventListener("input", calc);
    humSlider?.addEventListener("input", calc);

    calc();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupWindChill);
  } else {
    setupWindChill();
  }
  document.addEventListener("astro:page-load", setupWindChill);
</script>
