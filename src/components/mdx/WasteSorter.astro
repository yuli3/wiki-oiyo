---
/**
 * 자원순환 및 분리배출 스마트 판별기 (WasteSorter)
 *
 * 일상에서 자주 혼동되는 16대 생활 품목의 정확한 배출 분류함(일반종량제, 음식물, 불연성마대, 재활용, 전용수거함)과
 * 폐기물관리법 및 환경부 고시에 따른 공학적·법적 근거를 실시간으로 검색·필터링합니다.
 */

interface WasteItem {
  id: string;
  name: string;
  category: "general" | "food" | "non-combustible" | "recyclable" | "special";
  categoryLabel: string;
  badgeVariant: "default" | "secondary" | "destructive" | "outline";
  method: string;
  basis: string;
  keywords: string[];
}

