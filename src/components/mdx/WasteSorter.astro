---

<div class="not-prose my-8 rounded-xl border border-border bg-card p-4 sm:p-6 shadow-xs" id="waste-sorter-root">
  <div class="mb-4">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
      <h3 class="text-lg font-bold tracking-tight text-foreground sm:text-xl">
        생활 자원순환 품목별 배출 판별기
      </h3>
    </div>
    <p class="mt-1 text-xs text-muted-foreground sm:text-sm">
      버리려는 물품의 이름을 검색하거나 카테고리 탭을 선택하면 즉시 합법적 배출 경로와 법적 근거를 안내합니다.
    </p>
  </div>

  <!-- Search & Category Filters -->
  <div class="space-y-3">
    <div class="relative">
      <input
        type="search"
        id="waste-search-input"
        placeholder="물품명 검색 (예: 달걀껍질, 깨진유리, 아이스팩, 영수증...)"
        class="w-full rounded-lg border border-input bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        aria-label="생활 폐기물 품목 검색"
      />
    </div>

    <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="배출 분류 필터">
      <button
        type="button"
        data-filter-btn
        class="rounded-md border border-primary bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
        data-filter="all"
      >
        전체 보기
      </button>
      <button
        type="button"
        data-filter-btn
        class="rounded-md border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors"
        data-filter="general"
      >
        일반 종량제
      </button>
      <button
        type="button"
        data-filter-btn
        class="rounded-md border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors"
        data-filter="recyclable"
      >
        재활용 (페트·플라스틱·종이)
      </button>
      <button
        type="button"
        data-filter-btn
        class="rounded-md border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors"
        data-filter="non-combustible"
      >
        불연성 마대
      </button>
      <button
        type="button"
        data-filter-btn
        class="rounded-md border border-border bg-muted/60 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-muted transition-colors"
        data-filter="special"
      >
        전용 수거함 (약품·전지·가전)
      </button>
    </div>
  </div>

  <!-- Results Count -->
  <div class="mt-4 flex items-center justify-between border-b border-border pb-2 text-xs text-muted-foreground">
    <span id="waste-result-count">총 {wasteItems.length}개 품목 안내</span>
    <span class="text-xs">기준: 환경부 자원순환포털 및 폐기물관리법</span>
  </div>

  <!-- Cards Grid -->
  <div class="mt-4 grid gap-3 sm:grid-cols-2" id="waste-items-grid">
    {wasteItems.map((item) => (
      <div
        data-waste-card
        class="flex flex-col justify-between rounded-lg border border-border bg-background p-3.5 transition-shadow hover:shadow-xs"
        data-category={item.category}
        data-keywords={`${item.name} ${item.keywords.join(" ")} ${item.categoryLabel} ${item.method}`}
      >
        <div>
          <div class="flex items-start justify-between gap-2">
            <h4 class="text-sm font-bold text-foreground">
              {item.name}
            </h4>
            <span
              class:list={[
                "inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-xs font-semibold tracking-tight",
                item.category === "recyclable" && "bg-primary/10 text-primary border border-primary/20",
                item.category === "general" && "bg-muted text-muted-foreground border border-border",
                item.category === "non-combustible" && "bg-warning/10 text-warning border border-warning/20",
                item.category === "special" && "bg-destructive/10 text-destructive border border-destructive/20"
              ]}
            >
              {item.categoryLabel}
            </span>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-foreground/90">
            <strong class="font-semibold text-foreground">배출 요령:</strong> {item.method}
          </p>
        </div>
        <div class="mt-2.5 rounded border border-border/50 bg-muted/30 p-2 text-xs leading-normal text-muted-foreground">
          <strong class="font-medium text-foreground/80">공학·법적 근거:</strong> {item.basis}
        </div>
      </div>
    ))}
  </div>

  <div id="waste-no-results" class="hidden py-8 text-center text-sm text-muted-foreground">
    검색어와 일치하는 품목이 없습니다. 정확한 규격은 해당 시·군·구청 폐기물과 조례를 확인해 주세요.
  </div>
</div>

<script>
  function setupWasteSorter() {
    const root = document.getElementById("waste-sorter-root");
    if (!root) return;

    const input = root.querySelector<HTMLInputElement>("#waste-search-input");
    const filterBtns = root.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
    const cards = root.querySelectorAll<HTMLElement>("[data-waste-card]");
    const countEl = root.querySelector<HTMLElement>("#waste-result-count");
    const noResultsEl = root.querySelector<HTMLElement>("#waste-no-results");

    let currentFilter = "all";
    let searchQuery = "";

    function update() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      cards.forEach((card) => {
        const cat = card.dataset.category || "";
        const kw = (card.dataset.keywords || "").toLowerCase();

        const matchesCat = currentFilter === "all" || cat === currentFilter;
        const matchesQuery = !q || kw.includes(q);

        if (matchesCat && matchesQuery) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (countEl) {
        countEl.textContent = `검색 결과 ${visibleCount}개 품목`;
      }

      if (noResultsEl) {
        if (visibleCount === 0) {
          noResultsEl.classList.remove("hidden");
        } else {
          noResultsEl.classList.add("hidden");
        }
      }
    }

    if (input) {
      input.addEventListener("input", (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        update();
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove("bg-primary", "text-primary-foreground", "border-primary", "font-semibold");
          b.classList.add("bg-muted/60", "text-foreground", "border-border", "font-medium");
        });

        btn.classList.remove("bg-muted/60", "text-foreground", "border-border", "font-medium");
        btn.classList.add("bg-primary", "text-primary-foreground", "border-primary", "font-semibold");

        currentFilter = btn.dataset.filter || "all";
        update();
      });
    });
  }

  // Handle both initial load and client-side page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupWasteSorter);
  } else {
    setupWasteSorter();
  }
  document.addEventListener("astro:page-load", setupWasteSorter);
</script>
