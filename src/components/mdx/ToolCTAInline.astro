---
import { toolCtaHref } from '@/lib/tool-cta-href';
interface ToolMeta {
  name_ko: string;
  name_en: string;
  icon: string;
}

interface Props {
  tool: string;
  locale?: string;
}

const TOOL_META: Record<string, ToolMeta> = {
  compound: { name_ko: "복리 계산기", name_en: "Compound Interest", icon: "📈" },
  bmi: { name_ko: "BMI 계산기", name_en: "BMI Calculator", icon: "⚖️" },
  "year-end-settlement": { name_ko: "연말정산 계산기", name_en: "Year-End Settlement", icon: "💰" },
  "salary-calculator": { name_ko: "연봉 계산기", name_en: "Salary Calculator", icon: "💵" },
  "insurance-premium": { name_ko: "4대보험 계산기", name_en: "Insurance Calculator", icon: "🏥" },
  "early-repayment": { name_ko: "중도상환수수료 계산기", name_en: "Early Repayment Fee", icon: "🏦" },
  "property-tax": { name_ko: "재산세 계산기", name_en: "Property Tax", icon: "🏘️" },
  pension: { name_ko: "국민연금 계산기", name_en: "Pension Calculator", icon: "🎯" },
  "waste-sorter": { name_ko: "분리배출 판별기", name_en: "Waste Sorter", icon: "♻️" },
  "wind-chill": { name_ko: "체감온도 계산기", name_en: "Wind Chill Calculator", icon: "🌡️" },
  "business-day": { name_ko: "영업일·공휴일 조회기", name_en: "Business Day Checker", icon: "📅" },
  "net-salary": { name_ko: "실수령액 계산기", name_en: "Net Salary Calculator", icon: "💸" },
  "severance-pay-calc": { name_ko: "퇴직금 계산기", name_en: "Severance Pay Calculator", icon: "💼" },
  "annual-leave-calc": { name_ko: "연차수당 계산기", name_en: "Annual Leave Calculator", icon: "🏖️" },
};

const { tool, locale = "ko" } = Astro.props;

const meta = TOOL_META[tool];
if (!meta) return Astro.response;

const isKo = locale === "ko";
const name = isKo ? meta.name_ko : meta.name_en;
const label = isKo
  ? `${meta.icon} ${name}로 직접 계산해보세요 →`
  : `${meta.icon} Try the ${name} →`;
const href = toolCtaHref(tool, locale);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="not-prose inline-flex items-center gap-1.5 my-1 text-sm font-semibold text-green-700 hover:text-green-900 underline underline-offset-2 decoration-green-400/60 hover:decoration-green-600 transition-colors"
>
  {label}
</a>
