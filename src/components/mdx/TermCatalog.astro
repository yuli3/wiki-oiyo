---
// Emits a schema.org DefinedTermSet for a dictionary hub page, listing every
// member term (name + description + canonical URL) so the hub is machine-citable
// as a glossary catalog by search engines and AI. Term data is generated into
// src/data/term-catalogs.json from the hub MDX tables. Renders no visible UI.
import catalogs from "../../data/term-catalogs.json";
import { siteConfig } from "../../config/site.config";

interface Props {
  set: string; // "saju" | "tarot"
}
const { set } = Astro.props;

interface LocaleText { name?: string; description?: string }
interface Term { name: string; url?: string; description?: string; en?: LocaleText; ja?: LocaleText; zh?: LocaleText; fr?: LocaleText; es?: LocaleText }
const terms = ((catalogs as Record<string, Term[]>)[set]) ?? [];

// Locale = first path segment (e.g. /en/meaning-of-... → "en"); default ko.
const seg = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "ko";
const locale = ["ko", "en", "ja", "zh", "fr", "es"].includes(seg) ? seg : "ko";

const SET_NAME: Record<string, Record<string, string>> = {
  saju: {
    ko: "사주 명리 용어 사전", en: "Saju (Four Pillars) Glossary",
    ja: "四柱推命 用語辞典", zh: "四柱命理术语词典",
    fr: "Glossaire du Saju (Quatre Piliers)", es: "Glosario del Saju (Cuatro Pilares)",
  },
  tarot: {
    ko: "타로 메이저 아르카나 사전", en: "Tarot Major Arcana Glossary",
    ja: "タロット 大アルカナ辞典", zh: "塔罗大阿尔卡纳词典",
    fr: "Glossaire des Arcanes Majeurs du Tarot", es: "Glosario de Arcanos Mayores del Tarot",
  },
  crypto: { ko: "암호화폐·블록체인 용어 사전", en: "Crypto & Blockchain Glossary" },
  cert: { ko: "자격증 용어 사전", en: "Certification Terms Glossary" },
  gwansang: { ko: "관상 용어 사전", en: "Korean Physiognomy (Gwansang) Glossary" },
  mbti: { ko: "MBTI 16유형 사전", en: "MBTI 16 Personality Types Glossary" },
  zodiac: { ko: "별자리(12사인) 사전", en: "Zodiac Signs Glossary", ja: "12星座 辞典", zh: "十二星座词典", fr: "Glossaire des signes du zodiaque", es: "Glosario de signos del zodiaco" },
  "chinese-zodiac": { ko: "12간지(띠) 사전", en: "Chinese Zodiac Glossary", ja: "十二支 辞典", zh: "十二生肖词典", fr: "Glossaire du zodiaque chinois", es: "Glosario del zodiaco chino" },
  finance: { ko: "금융·투자 용어 사전", en: "Finance & Investing Glossary", ja: "金融・投資 用語辞典", zh: "金融与投资术语词典", fr: "Glossaire de la finance et de l'investissement", es: "Glosario de finanzas e inversión" },
  personality: { ko: "성격검사 용어 사전", en: "Personality Assessment Glossary", ja: "性格検査 用語辞典", zh: "性格测验术语词典", fr: "Glossaire des tests de personnalité", es: "Glosario de evaluación de personalidad" },
  big5: { ko: "Big5 30 패싯 사전", en: "Big Five 30 Facets Glossary", ja: "Big5 30ファセット辞典", zh: "大五人格30维度词典", fr: "Glossaire des 30 facettes du Big Five", es: "Glosario de las 30 facetas del Big Five" },
  enneagram: { ko: "에니어그램 9유형 사전", en: "Enneagram 9 Types Glossary", ja: "エニアグラム9タイプ辞典", zh: "九型人格词典", fr: "Glossaire des 9 types de l'Ennéagramme", es: "Glosario de los 9 tipos del Eneagrama" },
  disc: { ko: "DISC 4유형 사전", en: "DISC Four Styles Glossary", ja: "DISC 4スタイル辞典", zh: "DISC四种风格词典", fr: "Glossaire des 4 styles DISC", es: "Glosario de los 4 estilos DISC" },
  hexaco: { ko: "HEXACO 6요인 사전", en: "HEXACO Six Factors Glossary", ja: "HEXACO 6因子辞典", zh: "HEXACO六因素词典", fr: "Glossaire des 6 facteurs HEXACO", es: "Glosario de los 6 factores HEXACO" },
  attachment: { ko: "애착 유형 사전", en: "Attachment Styles Glossary", ja: "愛着スタイル辞典", zh: "依恋类型词典", fr: "Glossaire des styles d'attachement", es: "Glosario de estilos de apego" },
};
const setName = (SET_NAME[set]?.[locale]) ?? SET_NAME[set]?.en ?? set;
const canonical = `${siteConfig.url}${Astro.url.pathname}`;

const jsonLd = terms.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": `${canonical}#termset`,
  name: setName,
  url: canonical,
  inLanguage: locale,
  hasDefinedTerm: terms.map((t) => {
    // Localized term name/description when present, else fall back to ko (default fields).
    const loc = (t as unknown as Record<string, LocaleText | undefined>)[locale];
    const name = loc?.name ?? t.name;
    const description = loc?.description ?? t.description;
    return {
      "@type": "DefinedTerm",
      name,
      ...(description ? { description } : {}),
      ...(t.url ? { url: `${siteConfig.url}${t.url}` } : {}),
    };
  }),
}) : null;
---
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
