---
import { getCollection } from "astro:content";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { getTrackFromData, slugifyCategory } from "../lib/taxonomy";

interface Props {
  activeCategory?: string;
  locale: string;
}

const { activeCategory, locale } = Astro.props;

const t = await getTranslations(locale as Locale);
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };

const terms = await getCollection(
  "blog",
  ({ data }) => data.draft !== true && data.locale === locale && getTrackFromData(data) === "dictionary",
);
const categoryCounts = terms.reduce(
  (acc, post) => {
    const cat = post.data.category;
    if (!cat) return acc;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const categories = Object.keys(categoryCounts).sort();
---

<div class="space-y-12 mb-16">
  {
    categories.length > 0 && (
      <div class="animate-fade-up">
        <div class="relative">
          <div class="flex overflow-x-auto whitespace-nowrap gap-2 pb-4 scrollbar-hide w-full max-w-full snap-x snap-mandatory mask-gradient">
            {categories.map((cat) => {
              const slug = slugifyCategory(cat);
              const isActive = activeCategory === slug;
              return (
                <a
                  href={`/${locale}/category/${slug}`}
                  class:list={[
                    "px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all border snap-start",
                    isActive
                      ? "bg-primary text-primary-foreground border-primary shadow-lg shadow-primary/20"
                      : "bg-primary/5 text-primary/70 border-primary/20 hover:border-primary/40",
                  ]}
                >
                  {categoryNames[cat] ?? cat}{" "}
                  <span class="ml-1 opacity-40">({categoryCounts[cat]})</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .mask-gradient {
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }
</style>
