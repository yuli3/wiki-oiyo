---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CategoryCloud from "./CategoryCloud.astro";
import IntentBundles from "./IntentBundles.astro";
import Item from "./ui/Item.astro";
import { siteConfig } from "../config/site.config";
import { getTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface PageData {
  data: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
}

interface Props {
  availableLocales?: string[];
  page: PageData;
  locale: string;
  baseUrl: string;
  title: string;
  subtitle: string;
  activeCategory?: string;
  showIntentBundles?: boolean;
  useItemComposition?: boolean;
  /** Keep this listing out of the index — see the category/pagination policy. */
  noindex?: boolean;
}

const { page, locale, baseUrl, title, subtitle, activeCategory, showIntentBundles = false, useItemComposition = false, noindex } = Astro.props;
const paginationEnabled = siteConfig.features.pagination;
const t = await getTranslations(locale as Locale);
const categoryNames = (t.category.names ?? {}) as unknown as { [key: string]: string };
---

<BaseLayout title={title} description={subtitle} availableLocales={Astro.props.availableLocales} noindex={noindex}>
  <section class="py-16 md:py-20">
    <div class="container px-4">
      <div class="mb-12 max-w-2xl">
        <h1
          class="text-4xl font-bold tracking-tight sm:text-5xl mb-4 text-foreground"
        >
          {title}
          {
            page.currentPage > 1 && (
              <span class="text-xl text-muted-foreground font-normal ml-3">
                {t.blog.page} {page.currentPage}
              </span>
            )
          }
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {subtitle}
        </p>
      </div>

      {showIntentBundles
        ? <IntentBundles locale={locale} />
        : <CategoryCloud {locale} {activeCategory} />
      }

      <div class="flex flex-col divide-y divide-border/60">
        {
          page.data.map((post) => {
            // post.slug is like 'ko/visualizing-goals'; strip the lang prefix
            const slug = post.slug.split("/").slice(1).join("/");
            const href = `/${locale}/${slug}/`;
            const localizedCategory = (post.data.category ? categoryNames[post.data.category] : undefined) ?? post.data.category;
            const published = post.data.pubDate?.toLocaleDateString(
              locale === "ko" ? "ko-KR" : locale === "ja" ? "ja-JP" : locale === "zh" ? "zh-CN" : locale === "fr" ? "fr-FR" : locale === "es" ? "es-ES" : "en-US",
              { month: "short", day: "numeric", year: "numeric" },
            );

            if (useItemComposition) {
              return (
                <Item
                  href={href}
                  title={post.data.title}
                  description={post.data.description}
                  eyebrow={localizedCategory}
                  meta={published}
                  imageSrc={post.data.heroImage}
                  imageAlt={post.data.title}
                  class="my-2 px-4 py-4 sm:px-5"
                />
              );
            }

            return (
              <article class="group flex flex-col gap-4 py-6 md:flex-row md:items-center">
                {post.data.heroImage && (
                  <a
                    href={href}
                    class="w-full md:w-48 lg:w-56 aspect-[16/10] overflow-hidden rounded-xl border border-border bg-muted/20 shrink-0"
                  >
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                )}

                <div class="flex-1 min-w-0">
                  {localizedCategory && (
                    <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
                      {localizedCategory}
                    </div>
                  )}

                  <h2 class="mt-2 text-xl font-bold leading-snug group-hover:text-primary transition-colors tracking-tight">
                    <a href={href}>
                      {post.data.title}
                    </a>
                  </h2>

                  <div class="mt-2 flex items-center gap-3 text-[11px] text-muted-foreground/60">
                    {post.data.pubDate && (
                      <span>
                        {published}
                      </span>
                    )}
                    {post.data.author && (
                      <>
                        <span>·</span>
                        <span>{post.data.author}</span>
                      </>
                    )}
                  </div>

                  <p class="mt-3 text-muted-foreground line-clamp-3 text-sm leading-relaxed">
                    {post.data.description}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>

      {
        paginationEnabled && page.lastPage > 1 && (
          <Pagination
            currentPage={page.currentPage}
            totalPages={page.lastPage}
            baseUrl={baseUrl}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
